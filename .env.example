# MongoDB connection string
# For local: mongodb://localhost:27017/weddingcart
# For MongoDB Atlas: mongodb+srv://user:password@cluster.mongodb.net/weddingcart
MONGODB_URI=mongodb://localhost:27017/weddingcart

# Cloudinary (image CDN)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# Admin auth (legacy, MongoDB-era — being replaced by Auth.js/Postgres below,
# still live until each admin module cuts over per docs/postgres-migration-plan.md)
# ADMIN_SECRET must be a long random string (e.g. openssl rand -hex 32)
ADMIN_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD=
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_PASSWORD=

# PostgreSQL (Supabase) — Phase A migration, see docs/postgres-migration-plan.md
# DATABASE_URL: pooled connection (pgbouncer), used by the running app
# DIRECT_URL: direct connection, used by `prisma migrate` only
DATABASE_URL=
DIRECT_URL=

# Auth.js (NextAuth v4) — replaces ADMIN_SECRET/ADMIN_USERNAME above, module by module
# NEXTAUTH_SECRET must be a long random string (e.g. openssl rand -hex 32)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# The legacy admin auth above uses usernames (e.g. "Gaurav_Singh"), not emails,
# but the new Postgres User table's Credentials provider looks accounts up by
# email. Real addresses, not fabricated ones — required by
# scripts/migrate-to-postgres.mjs to seed the two admin User rows; the script
# fails clearly rather than guessing if these are unset.
SUPER_ADMIN_EMAIL=
ADMIN_EMAIL=

# /api/seed double safeguard: disabled in production regardless of this value;
# in dev/staging requires BOTH a Super Admin session AND this set to true
SEED_ENABLED=false

# WhatsApp Business API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Admin phone to receive consultation alerts (with country code, no +)
WHATSAPP_ADMIN_PHONE=91XXXXXXXXXX
# Name shown in WhatsApp confirmation messages
EXPERT_NAME=Priya Mishra

# Razorpay (payment gateway) — Sprint 7.2, Payment Links API
# Test-mode keys from Razorpay Dashboard > Settings > API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret set in Razorpay Dashboard > Settings > Webhooks (same value
# entered there and here — used to verify x-razorpay-signature via HMAC-SHA256)
RAZORPAY_WEBHOOK_SECRET=

# Site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
