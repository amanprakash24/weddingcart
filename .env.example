# PostgreSQL (Supabase) — the live database, see docs/postgres-migration-plan.md
# DATABASE_URL: pooled connection (pgbouncer), read by the running app (lib/prisma.ts)
# DIRECT_URL: direct (non-pooled) connection, used by `prisma migrate`/deploy tooling
DATABASE_URL=
DIRECT_URL=

# Auth.js (NextAuth v4) — session JWT signing/verification (proxy.ts, lib/auth/auth.ts)
# NEXTAUTH_SECRET must be a long random string (e.g. openssl rand -hex 32)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Cloudinary (image CDN)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# VendorPaymentDetails.bankAccountNumber field encryption (lib/crypto/encryption.ts).
# 32-byte key as 64-char hex (openssl rand -hex 32). Use a DIFFERENT key per
# environment — never share a key between staging and production, never commit
# a real value here. Losing this key makes all encrypted bank details
# permanently unrecoverable, so back it up outside the repo (secrets manager,
# not a file).
BANK_ACCOUNT_ENCRYPTION_KEY=

# WhatsApp Business API — OTP delivery (app/api/otp/send) and consultation alerts
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Admin phone to receive consultation alerts (with country code, no +)
WHATSAPP_ADMIN_PHONE=91XXXXXXXXXX
# Name shown in WhatsApp confirmation messages
EXPERT_NAME=Priya Mishra

# /api/seed double safeguard: disabled in production regardless of this value;
# in dev/staging requires BOTH a Super Admin session AND this set to true
SEED_ENABLED=false

# Razorpay (payment gateway) — Payment Links API
# (services/payment.service.ts, app/api/payments/webhook)
# Test-mode keys from Razorpay Dashboard > Settings > API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret set in Razorpay Dashboard > Settings > Webhooks (same value
# entered there and here — used to verify x-razorpay-signature via HMAC-SHA256)
RAZORPAY_WEBHOOK_SECRET=

# Site URL (no trailing slash) — used in metadata, sitemap, and JSON-LD across the app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics (gtag.js, loaded in app/layout.tsx) — falls back to a
# hardcoded measurement ID if unset, so this is optional for local dev
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Ads conversion tracking for the /plan consultation wizard
# (lib/analytics/googleAds.ts) — fires through the same gtag.js instance
# loaded in app/layout.tsx, not a second tag. Both must be set for the
# conversion event to fire; until then it silently no-ops. Get these from
# Google Ads > Goals > Conversions > (your conversion action) > Tag setup.
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=

# -----------------------------------------------------------------------------
# One-time historical migration / data-fix scripts only (scripts/*.mjs) — NOT
# read anywhere by the running application. The Mongo -> Postgres migration
# already completed and lib/mongodb.ts has no live callers; these are kept
# only so those scripts remain runnable for reference/audit purposes.
# -----------------------------------------------------------------------------

# Source database for the completed migration and ~20 one-off Patna-vendor
# content-fix scripts under scripts/*.mjs.
MONGODB_URI=mongodb://localhost:27017/weddingcart

# Read once by scripts/migrate-to-postgres.mjs to seed the initial
# SUPER_ADMIN/SALES User rows (bcrypt-hashed into Postgres, per the script's
# own "SUPER_ADMIN_EMAIL/ADMIN_EMAIL in .env.local" error message). Real admin
# login today is NextAuth + that resulting passwordHash — none of these six
# vars are read anywhere in the running application.
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=
