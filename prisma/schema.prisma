// Phase A: 1:1 relational port of the current MongoDB/Mongoose data model
// (Marketplace/CRM sections below). See docs/postgres-migration-plan.md.
//
// Phase B (added 2026-07-19): the Wedding OS schema, per docs/wedding-os/domain-model.md.
// Deliberately NOT a continuation of Phase A's 1:1-port style — greenfield modeling
// around the Wedding aggregate, coexisting with the migrated marketplace tables
// rather than forcing new concepts into old ones. Phase A models below gain only
// additive fields/back-relations (marked "Phase B addition") — nothing existing
// is removed or renamed.
//
// Organized into commented sections per docs/wedding-os/domain-model.md's bounded
// contexts: Marketplace, CRM, Wedding OS, Finance, Vendor OS, Identity, AI,
// Shared (entities referenced across contexts by design: Task, ActivityLog,
// ApprovalRequest). One physical file for now — the section comments are the
// navigation aid.
//
// Architectural principle applied throughout Phase B, per explicit instruction:
// "don't store dashboard state, store events." Wedding/VendorBooking/Task carry
// ordinary mutable status fields (for query simplicity), but every meaningful
// transition should also write an ActivityLog entry — ActivityLog is the
// append-only event trail (no updatedAt, immutable by convention) that Health
// Score, progress %, and AI summaries derive from, rather than a separately
// cached "health" column that can drift from reality. This is a lighter
// state+event-log hybrid, not full event sourcing — flagged as a deliberate
// choice, not the only option.

// Prisma 7: connection URL lives in prisma.config.ts (CLI) and is passed via a
// driver adapter to the PrismaClient constructor at runtime (see lib/prisma.ts) —
// `url`/`directUrl` are no longer valid in the schema's datasource block.
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums (Marketplace/CRM, Phase A) ----------

enum Role {
  SUPER_ADMIN
  SALES
  // Phase B addition — resolves the "Operations role" question left open in
  // docs/wedding-os/01-command-center.md §2. Chose a real enum value over a
  // permission-flag-on-SALES approach for consistency with how every other
  // role in this codebase is modeled. Flagging the call, not silently assuming
  // it's uncontroversial — reversible if a flag-based approach is preferred later.
  OPERATIONS
  VENDOR
  CUSTOMER
}

enum ApplicationStatus {
  NEW
  APPROVED
  REJECTED
}

enum BookingStatus {
  NEW
  CONTACTED
  CONFIRMED
  CLOSED
}

enum EnquiryStatus {
  NEW
  CONTACTED
  CLOSED
}

enum ConsultationStatus {
  NEW
  CONTACTED
  CLOSED
}

enum InvoiceStatus {
  DRAFT
  SENT // issued to the customer (set when staff issue it or a payment link is created)
  PARTIALLY_PAID // some, but not all, of the total has been received
  PAID
}

// What an invoice is for. ADVANCE / BALANCE are the two invoices of an accepted quotation (at most one of each per
// quotation); OTHER is everything created by hand.
enum InvoiceKind {
  ADVANCE
  BALANCE
  OTHER
}

enum BlogStatus {
  DRAFT
  PUBLISHED
}

// ---------- Auth (Auth.js) ----------

// Credentials-only (no OAuth) for Phase A, so no Account/Session/VerificationToken
// adapter tables — session strategy is JWT. Add the adapter tables later if an
// OAuth provider is introduced.
model User {
  id           String   @id @default(uuid())
  name         String?
  email        String?  @unique
  phone        String?  @unique
  // Set only for SUPER_ADMIN / SALES / OPERATIONS (credentials login).
  // Null for VENDOR / CUSTOMER, which authenticate via phone + OTP.
  passwordHash String?
  // Logout-everywhere: every session token carries the version it was issued with; logging out increments this,
  // which invalidates ALL of this user's tokens on every device (lib/auth/sessionVersion.ts).
  sessionVersion Int @default(0)
  image        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Identity/role redesign (Step 4 review, 2026-07-19): one User per phone
  // number can now hold MULTIPLE roles (e.g. a vendor who also books their own
  // wedding as a customer) — replaces the single `role Role` field. Role-
  // specific data lives in the profile tables below, not flat on User, so
  // identity stays separate from capability-specific fields.
  roles           UserRole[]
  customerProfile CustomerProfile?
  vendorProfile   VendorProfile?
  employeeProfile EmployeeProfile?

  // Phase B back-relations (Wedding OS) — every internal team member (Founder/
  // Sales/Operations) and Vendor/Customer login funnels through this same User
  // table; these are the many places Wedding OS entities reference a user.
  weddingsAsCustomer        Wedding[]           @relation("WeddingCustomer")
  weddingsAsCoordinator     Wedding[]           @relation("WeddingCoordinator")
  paymentsRecorded          Payment[]           @relation("PaymentRecordedBy")
  leadsAssigned             Lead[]              @relation("LeadAssignedTo")
  leadsAssignedByMe         Lead[]              @relation("LeadAssignedBy")
  enquiriesAssigned         Enquiry[]           @relation("EnquiryAssignedTo")
  enquiriesAssignedByMe     Enquiry[]           @relation("EnquiryAssignedBy")
  consultationsAssigned     Consultation[]      @relation("ConsultationAssignedTo")
  consultationsAssignedByMe Consultation[]      @relation("ConsultationAssignedBy")
  tasksAssigned             Task[]              @relation("TaskAssignedTo")
  tasksCreated              Task[]              @relation("TaskCreatedBy")
  activitiesPerformed       ActivityLog[]       @relation("ActivityPerformedBy")
  activitiesApproved        ActivityLog[]       @relation("ActivityApprovedBy")
  approvalsRequested        ApprovalRequest[]   @relation("ApprovalRequestedBy")
  approvalsGiven            ApprovalRequest[]   @relation("ApprovalApprovedBy")
  timelineMilestonesOwned   TimelineMilestone[]
  documentsUploaded         Document[]
  quotationsCreated         Quotation[]         @relation("QuotationCreatedBy")
  partnerReferralsAssigned  PartnerReferral[]   @relation("PartnerReferralAssignedTo")
  vendorEnquiriesAnswered   VendorEnquiry[]     @relation("VendorEnquiryAnsweredBy")
  quotationsAccepted        Quotation[]         @relation("QuotationAcceptedBy")
  aiConversations           AiConversation[]
  notifications             Notification[]
  paymentLinks              PaymentLink[]

  businessMemberships BusinessMember[] // the businesses this login works in (Owner / Staff)

  @@map("users")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role
  createdAt DateTime @default(now())

  @@unique([userId, role])
  @@map("user_roles")
}

// Intentionally thin for v1 — no customer-specific field has been named by any
// Wedding OS doc yet beyond what Couple/Wedding already capture. Exists now so
// the identity/profile separation is established structurally; extend with
// real fields (saved addresses, preferences) when a real need names one,
// rather than inventing fields speculatively.
model CustomerProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("customer_profiles")
}

// Replaces the old `User.vendorId` direct field — the link between a login
// identity and the (already rich) Vendor business-listing record, which stays
// unchanged as the actual profile data.
model VendorProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendorId  String   @unique
  vendor    Vendor   @relation(fields: [vendorId], references: [id])
  createdAt DateTime @default(now())

  @@map("vendor_profiles")
}

// Intentionally thin for v1, same reasoning as CustomerProfile — for
// SUPER_ADMIN/SALES/OPERATIONS team members. Extend when a real
// employee-specific field is needed (department, hire date, etc.).
model EmployeeProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("employee_profiles")
}

// Ephemeral phone verification for public lead capture (not a login session).
// No DB-native TTL in Postgres — app must filter `WHERE expiresAt > now()`,
// and a daily cron/cleanup job should delete expired rows.
model Otp {
  id        String   @id @default(uuid())
  phone     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone])
  @@map("otps")
}

// Security checklist item #2 (docs/security-checklist.md) — rate limiting on
// login attempts. No in-memory approach (a Map, a simple counter) is reliable
// here: Vercel is serverless/multi-instance, so in-memory state doesn't
// persist or share across invocations. Postgres-backed instead — consistent
// with the frozen stack (no new infra like Redis) and works correctly
// regardless of how many instances are handling requests. One row per
// attempt (not a running counter) so the lockout window is a simple count
// query, not a field that needs careful concurrent-update handling.
model LoginAttempt {
  id         String   @id @default(uuid())
  identifier String // email or phone attempted against a Credentials provider
  success    Boolean
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
  @@map("login_attempts")
}

// ---------- Catalog ----------

model Category {
  id            String   @id @default(uuid())
  // Original Mongo `_id` (ObjectId, stringified), preserved on every migrated
  // table (not User/Otp — those have no Mongo source). Exists solely so
  // scripts/validate-post-migration.mjs can match records across the two
  // databases for checksum comparison — never exposed via any API response.
  legacyMongoId String?  @unique
  slug          String   @unique // was Mongo's human-readable `id` field (e.g. "venue", "makeup")
  name          String
  icon          String
  description   String
  image         String
  isSpecial     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  vendors            Vendor[]
  vendorApplications VendorApplication[]
  commissionRates    CommissionRate[] // Phase B — nullable-categoryId rows are the global default rate
  consultationSelections ConsultationVendorSelection[]

  @@map("categories")
}

// Vendor Portal — admin publishing workflow. PUBLISHED is the only status
// visible to anonymous/public callers (see vendor.service.ts's buildWhere
// and every public route's status gate); DRAFT/PENDING_VERIFICATION are
// admin-only, reachable through /admin/vendors and an authenticated preview
// of the public profile.
enum VendorStatus {
  DRAFT
  PENDING_VERIFICATION
  PUBLISHED
}

enum VendorPriceUnit {
  PER_PLATE
  PACKAGE
}

model Vendor {
  id               String           @id @default(uuid())
  legacyMongoId    String?          @unique
  slug             String           @unique // was Mongo's human-readable `id` field, still used in /vendors/[id] URLs
  name             String
  ownerName        String           @default("")
  ownerPhone       String           @default("")
  ownerEmail       String           @default("")
  categoryId       String
  category         Category         @relation(fields: [categoryId], references: [id])
  city             String
  address          String           @default("")
  mapEmbedUrl      String           @default("")
  priceMin         Int
  priceMax         Int
  // What priceMin/priceMax actually mean — a venue billed per plate (catering included) and one billed
  // as a flat hall rental are both real, common pricing models in this market, and mixing them in one
  // listing grid with no label is genuinely confusing (₹1,00,000 flat next to ₹850/plate reads like a
  // 100x price difference at a glance). Nullable — existing vendors show no unit suffix until an admin
  // sets this explicitly; never guessed or backfilled automatically.
  priceUnit        VendorPriceUnit?
  rating           Float            @default(4.5)
  reviewCount      Int              @default(0)
  image            String
  images           String[]         @default([])
  virtualTourVideo String           @default("")
  description      String
  features         String[]         @default([])
  isFeatured       Boolean          @default(false)
  sortOrder        Int              @default(999)
  status           VendorStatus     @default(DRAFT)
  // Structured (not folded into `features`) because the marketplace card
  // and search need to sort/filter on these directly — e.g. "capacity
  // 200-500", not parse it out of free text. Nullable: most vendor
  // categories (photographers, makeup artists, ...) have neither.
  guestCapacity    Int?
  venueType        String?
  // Structured locality within `city` (e.g. "Danapur", "Boring Road") — deliberately separate from the
  // free-text `address` field, which mixes street address and locality together and can't be reliably
  // matched on ("near Boring Road" vs. actually on it — a real false-positive this was built to avoid).
  // Admin-set only (a dropdown of known localities, see AdminVendorFormClient.tsx), never guessed from
  // `address` text. Drives the /venues/{city}/{area} local-SEO pages: a page queries this field directly
  // and lists nothing it can't verify. Nullable — most vendors, and most cities, don't have this yet.
  area             String?
  // Commercial V1: the vendor's (venue's) default Terms & Conditions. COPIED into a quotation when it is created —
  // changing this later never alters an existing quotation, booking or invoice.
  defaultTerms     String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  packages      VendorPackage[]
  faqs          VendorFaq[]
  application   VendorApplication?
  vendorProfile VendorProfile? // Phase B — replaces the old direct User.vendorId link
  bookingItems  BookingItem[]
  enquiries     Enquiry[]

  // Phase B (Wedding OS / Vendor OS / Finance)
  vendorBookings    VendorBooking[]
  payouts           Payout[]
  // Route A commercial-tier history — see PartnerAgreement's own comment. Required by Prisma
  // as the opposite side of that model's `vendor` relation; nothing reads this list yet.
  partnerAgreements PartnerAgreement[]
  availability      VendorAvailability[]
  reviews           Review[]
  paymentDetails    VendorPaymentDetails?
  quotationItems    QuotationItem[]
  consultationSelections ConsultationVendorSelection[]
  vendorEnquiries        VendorEnquiry[] @relation("VendorEnquiries")
  // Which wedding functions this vendor can serve (docs/wedding-os/11-vivah-os-ux-architecture.md §15) —
  // deliberately not a backfill: an existing vendor with zero rows here just has no known capabilities yet,
  // not an error. Establishes the data only; nothing reads this for matching/assignment yet (a later step).
  capabilities      VendorCapability[]

  // categoryId+city+status is every public listing query's exact where
  // clause (city/category page, sitemap, /api/vendors search); rating stays
  // last since it's usually a sort key layered on top, not a filter.
  @@index([categoryId, city, status, rating])
  business Business? // the Vivah OS business behind this public listing, once it uses Vivah OS

  @@map("vendors")
}

// docs/wedding-os/11-vivah-os-ux-architecture.md §14-15 — the smallest V1 model that lets a vendor record
// which wedding functions they serve, without redesigning the quotation/matching pipeline. Reuses the
// existing WeddingEventType enum (no new function taxonomy) and Vendor (no new top-level entity). Deliberately
// function-level, not category-scoped — a vendor either serves a function or doesn't, in V1. Not read by
// anything yet: no matching, no vendor-search filtering, no quotation change. That's a later, separate step.
model VendorCapability {
  id        String           @id @default(uuid())
  vendorId  String
  vendor    Vendor           @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  function  WeddingEventType
  createdAt DateTime         @default(now())

  @@unique([vendorId, function])
  @@map("vendor_capabilities")
}

model VendorPackage {
  id            String   @id @default(uuid())
  legacyMongoId String?  @unique
  vendorId      String
  vendor        Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  name          String
  description   String
  price         Int
  features      String[] @default([])
  isPopular     Boolean  @default(false)
  isPerPlate    Boolean  @default(false)
  image         String   @default("")

  vendorBookings VendorBooking[] // Phase B

  @@map("vendor_packages")
}

model VendorFaq {
  id            String  @id @default(uuid())
  legacyMongoId String? @unique
  vendorId      String
  vendor        Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  question      String
  answer        String

  @@map("vendor_faqs")
}

model VendorApplication {
  id              String             @id @default(uuid())
  legacyMongoId   String?            @unique
  businessName    String
  ownerName       String
  ownerPhone      String
  ownerEmail      String
  categoryId      String
  category        Category           @relation(fields: [categoryId], references: [id])
  city            String
  priceMin        Int                @default(0)
  priceMax        Int                @default(0)
  experience      String             @default("")
  description     String             @default("")
  instagram       String             @default("")
  website         String             @default("")
  coverImage      String             @default("")
  portfolioImages String[]           @default([])
  foodMenuImages  String[]           @default([])
  // Draft capture at application time, mirroring portfolioImages/foodMenuImages's array-field convention
  // above rather than a second join table — this vendor doesn't exist yet, so there's no vendorId to key a
  // VendorCapability row on. Copied into real VendorCapability rows on Vendor when the application is
  // approved (vendorApplication.service.ts) — never left to just disappear at approval.
  capabilities    WeddingEventType[] @default([])
  status          ApplicationStatus  @default(NEW)
  vendorId        String?            @unique
  vendor          Vendor?            @relation(fields: [vendorId], references: [id])
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@map("vendor_applications")
}

// Sales-side outreach tracker for venues not yet on ShaadiShopping — distinct from VendorApplication
// (which is the venue's OWN self-submitted onboarding form). A VendorProspect starts from a list Sales
// is working (e.g. a competitor-site venue list used for outreach leads only, never their descriptions/
// photos — see docs/wedding-os/12-vendor-prospects.md) and is meant to end at either ONBOARDED (someone
// actually went through VendorApplication) or DECLINED/ALREADY_LISTED. Deliberately no FK to Vendor or
// VendorApplication: linking is a manual status change for V1, not automated matching.
enum VendorProspectStatus {
  NEW
  CONTACTED
  INTERESTED
  ONBOARDING
  ONBOARDED
  DECLINED
  ALREADY_LISTED
}

model VendorProspect {
  id                  String               @id @default(uuid())
  name                String
  area                String?
  fullAddress         String?
  city                String
  // Not unique — the same phone legitimately appears on more than one prospect row (one owner/group
  // running several halls), confirmed against real scraped data before this was modeled.
  phone               String
  email               String?
  contactPerson       String?
  seatingCapacity     Int?
  maxCapacity         Int?
  priceVegPerPlate    Int?
  priceNonVegPerPlate Int?
  venueType           String?
  status              VendorProspectStatus @default(NEW)
  notes               String?
  source              String
  sourceUrl           String?
  lastContactedAt     DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([status])
  @@index([phone])
  @@map("vendor_prospects")
}

// ---------- Leads / bookings / consultations ----------
// customerId is reserved (nullable, no FK enforced yet) on every lead-shaped
// table so Phase B can link these rows to a Customer/Wedding without a
// second destructive schema migration.

model Lead {
  id            String   @id @default(uuid())
  legacyMongoId String?  @unique
  phone         String
  whatsapp      Boolean  @default(false)
  source        String   @default("popup")
  customerId    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Phase B (CRM, docs/wedding-os/02-crm.md) — additive, existing `customerId`
  // stays as the eventual Wedding link (populated on WON, see Wedding.sourceLeadId).
  pipelineStage    PipelineStage @default(NEW)
  assignedToId     String?
  assignedTo       User?         @relation("LeadAssignedTo", fields: [assignedToId], references: [id])
  // Sprint 5.3 — "Assigned To/By/At" per the workflow-engine reframing; full
  // assignment history also lands in ActivityLog(ASSIGNED), these columns are
  // just the current value, same pattern as lostReason below.
  assignedById     String?
  assignedBy       User?         @relation("LeadAssignedBy", fields: [assignedById], references: [id])
  assignedAt       DateTime?
  // lostReason is a closed set (Sprint 5.3 state machine) with an optional
  // free-text elaboration only used when OTHER is picked. holdReason is free
  // text (no closed set requested) and clears once a lead leaves ON_HOLD —
  // the permanent record of both lives in ActivityLog(STATUS_CHANGED).
  lostReason       LostReason?
  lostReasonDetail String?
  holdReason       String?
  tasks            Task[]
  activities       ActivityLog[]
  quotations       Quotation[]
  vendorEnquiries  VendorEnquiry[]
  insights         LeadInsight[]
  wedding          Wedding?

  // Production-hardening audit (2026-09-01): pipelineStage/assignedToId are
  // filtered on every CRM Lead Inbox, Command Center, and Founder Dashboard
  // load (leadInbox.service.ts, commandCenter.service.ts,
  // founderDashboard.service.ts's getTeamPerformance, which queries
  // {assignedToId, pipelineStage} together per sales rep); createdAt is the
  // default list() sort and every dashboard's date-range count filter.
  @@index([pipelineStage])
  @@index([assignedToId, pipelineStage])
  @@index([createdAt])
  // Record ownership (docs/wedding-os/15-record-ownership.md). Phase A: every row belongs to Shaadi Shopping by default; Phase B
  // removes the default and every query is scoped by the logged-in business.
  businessId String   @default("shaadi-shopping")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@index([businessId])
  @@map("leads")
}

model Enquiry {
  id             String        @id @default(uuid())
  legacyMongoId  String?       @unique
  vendorId       String
  vendor         Vendor        @relation(fields: [vendorId], references: [id])
  vendorName     String
  vendorCategory String
  name           String
  phone          String
  email          String?
  city           String
  eventDate      String
  guestCount     String?
  eventType      String
  message        String?
  status         EnquiryStatus @default(NEW)
  customerId     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Phase B (CRM) — see Lead's identical addition for the reasoning
  pipelineStage    PipelineStage @default(NEW)
  assignedToId     String?
  assignedTo       User?         @relation("EnquiryAssignedTo", fields: [assignedToId], references: [id])
  assignedById     String?
  assignedBy       User?         @relation("EnquiryAssignedBy", fields: [assignedById], references: [id])
  assignedAt       DateTime?
  lostReason       LostReason?
  lostReasonDetail String?
  holdReason       String?
  tasks            Task[]
  activities       ActivityLog[]
  quotations       Quotation[]
  vendorEnquiries  VendorEnquiry[]
  insights         LeadInsight[]
  wedding          Wedding?
  // Duplicate-Wedding guard (production-integrity fix) — lets a Booking
  // created from this Enquiry (e.g. the admin "Create Booking" action) be
  // traced back for the cross-path check in services/weddingConversion
  // .service.ts's findWeddingForSource(). Not unique — an Enquiry may
  // reasonably have more than one Booking attempt before one is confirmed.
  bookings         Booking[]

  // Consultation -> Enquiry bridge — the admin "Start Enquiry" action on a
  // Consultation card (components/AdminClient.tsx) creates a normal Enquiry
  // (vendor picked by the coordinator, since a Consultation has no vendor of
  // its own) and links it back here. Deliberately not unique: one
  // Consultation can reasonably produce more than one Enquiry (different
  // vendors/categories), same relationship shape as Enquiry.bookings above.
  consultationId String?
  consultation   Consultation? @relation(fields: [consultationId], references: [id])

  // Production-hardening audit (2026-09-01) — see Lead's identical indexes
  // for the reasoning.
  @@index([pipelineStage])
  @@index([assignedToId, pipelineStage])
  @@index([createdAt])
  @@index([consultationId])
  // Record ownership (docs/wedding-os/15-record-ownership.md). Phase A: every row belongs to Shaadi Shopping by default; Phase B
  // removes the default and every query is scoped by the logged-in business.
  businessId String   @default("shaadi-shopping")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@index([businessId])
  @@map("enquiries")
}

model Consultation {
  id             String             @id @default(uuid())
  legacyMongoId  String?            @unique
  name           String
  phone          String
  email          String             @default("")
  city           String?
  eventType      String             @default("wedding")
  weddingDate    String
  days           Int
  guestCount     Int
  foodPreference String             @default("veg")
  services       String[]           @default([])
  venueType      String             @default("")
  preferredTime  String?
  message        String?
  // Where the enquiry came from (docs/wedding-os/15-record-ownership.md §4.4): null = Shaadi Shopping's website (the /plan wizard);
  // a venue's own enquiry records its channel — PHONE, WALK_IN, WHATSAPP, INSTAGRAM, GOOGLE, REFERENCE, EXISTING_CUSTOMER, OTHER.
  channel        String?
  cartItems      Json?
  totalBudget    Int?
  budgetRange    String?
  status         ConsultationStatus @default(NEW)
  // weddingStyle / consultationDate were written by the API but
  // absent from the Mongoose schema (drift). Live-data audit (2026-07-19,
  // 16/16 docs) found them 0% populated — dropped rather than carried forward
  // as permanently-empty columns. See docs/postgres-migration-plan.md §5.
  customerId     String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  // Phase B (CRM) — see Lead's identical addition for the reasoning
  pipelineStage    PipelineStage @default(NEW)
  assignedToId     String?
  assignedTo       User?         @relation("ConsultationAssignedTo", fields: [assignedToId], references: [id])
  assignedById     String?
  assignedBy       User?         @relation("ConsultationAssignedBy", fields: [assignedById], references: [id])
  assignedAt       DateTime?
  lostReason       LostReason?
  lostReasonDetail String?
  holdReason       String?
  tasks            Task[]
  activities       ActivityLog[]
  quotations       Quotation[]
  insights         LeadInsight[]
  wedding          Wedding?
  // Duplicate-Wedding guard (production-integrity fix) — see Enquiry's
  // identical addition for the reasoning. Not unique for the same reason.
  bookings         Booking[]
  // Consultation -> Enquiry bridge — inverse side of Enquiry.consultationId
  // above. One Consultation can produce multiple Enquiries.
  enquiries        Enquiry[]
  vendorSelections ConsultationVendorSelection[]
  vendorEnquiries  VendorEnquiry[]

  // Production-hardening audit (2026-09-01) — see Lead's identical indexes
  // for the reasoning.
  @@index([pipelineStage])
  @@index([assignedToId, pipelineStage])
  @@index([createdAt])
  // Record ownership (docs/wedding-os/15-record-ownership.md). Phase A: every row belongs to Shaadi Shopping by default; Phase B
  // removes the default and every query is scoped by the logged-in business.
  businessId String   @default("shaadi-shopping")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@index([businessId])
  @@map("consultations")
}

model ConsultationVendorSelection {
  id             String       @id @default(uuid())
  consultationId String
  serviceKey     String
  categoryId     String?
  vendorId       String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  category       Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  vendor         Vendor       @relation(fields: [vendorId], references: [id], onDelete: Restrict)

  @@unique([consultationId, serviceKey])
  @@index([vendorId])
  @@index([categoryId])
  @@map("consultation_vendor_selections")
}

model Booking {
  id            String        @id @default(uuid())
  legacyMongoId String?       @unique
  name          String
  phone         String
  city          String
  total         Int
  status        BookingStatus @default(NEW)
  customerId    String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Phase B — resolved 2026-07-19 (docs/wedding-os/domain-model.md §5): collected
  // at checkout, not at confirmation. weddingDate is the "Booking Date" concept
  // (customer's intended date, may change) — becomes the first WeddingEvent's
  // default date on conversion, distinct from WeddingEvent.date going forward.
  // Nullable at the DB level only because existing Bookings predate this field —
  // the checkout form must treat it as required for every new submission
  // (application-level validation, not a DB constraint, so historical rows don't
  // need a backfill to stay valid).
  weddingDate DateTime?
  weddingType String?
  guestCount  Int?

  // Duplicate-Wedding guard (production-integrity fix, docs: prior
  // investigation found that a Booking created from an Enquiry/Consultation
  // had no way to be traced back to it, so the CRM conversion path and this
  // Booking's own confirm-to-Wedding path could independently produce two
  // separate Weddings for the same underlying customer request). Nullable
  // and not unique — set only when a Booking is created from an existing
  // Enquiry/Consultation (e.g. the admin "Create Booking" action); ordinary
  // public /cart checkout bookings leave both null, unaffected. Not unique
  // because more than one Booking attempt may exist before one is
  // confirmed — see services/weddingConversion.service.ts's
  // findWeddingForSource() for how this is used to detect an existing
  // Wedding across both conversion paths.
  enquiryId      String?
  enquiry        Enquiry?      @relation(fields: [enquiryId], references: [id])
  consultationId String?
  consultation   Consultation? @relation(fields: [consultationId], references: [id])

  items     BookingItem[]
  invoices  Invoice[] // invoices raised for this booking (advance, balance)
  wedding   Wedding? // set once status reaches CONFIRMED and this converts
  agreement CommercialAgreement? // the frozen commercial terms of the accepted quotation this booking was made from

  // Lookups by these two (findByLinkedBookingEnquiryId/
  // findByLinkedBookingConsultationId, the cross-path duplicate-Wedding
  // guard) run on every CRM conversion/idempotency check, not just this
  // Booking's own confirm — same "hot lookup column" reasoning as the
  // pipelineStage indexes above.
  // Set when the Booking was created from an ACCEPTED quotation (08-quotation.md).
  // Unique → a second Booking for the same quotation fails cleanly at the database.
  quotationId String?    @unique
  quotation   Quotation? @relation(fields: [quotationId], references: [id])

  @@index([enquiryId])
  @@index([consultationId])
  // Record ownership (docs/wedding-os/15-record-ownership.md). Phase A: every row belongs to Shaadi Shopping by default; Phase B
  // removes the default and every query is scoped by the logged-in business.
  businessId String   @default("shaadi-shopping")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@index([businessId])
  @@map("bookings")
}

model BookingItem {
  id             String  @id @default(uuid())
  legacyMongoId  String? @unique
  bookingId      String
  booking        Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  vendorId       String?
  vendor         Vendor? @relation(fields: [vendorId], references: [id])
  vendorName     String
  vendorCategory String
  packageName    String
  price          Int
  quantity       Int

  @@map("booking_items")
}

model Invoice {
  id            String        @id @default(uuid())
  legacyMongoId String?       @unique
  invoiceNumber String        @unique
  clientName    String
  clientPhone   String
  clientEmail   String?
  clientCity    String?
  eventDate     String?
  eventType     String?
  subtotal      Int
  discount      Int           @default(0)
  gstEnabled    Boolean       @default(true)
  gstAmount     Int           @default(0)
  total         Int
  amountPaid    Int           @default(0)
  notes         String?
  status        InvoiceStatus @default(DRAFT)
  customerId    String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  items InvoiceItem[]

  // Phase B (Finance, docs/wedding-os/06-finance.md) — weddingId links this
  // invoice to a Wedding once one exists. `amountPaid` above stays as a Phase A
  // column for now; 06-finance.md §2 proposes it become computed-on-read from
  // `payments` in Step 3's application layer, not renamed/removed here to avoid
  // a breaking change to Milestone 2's existing repository/service code.
  weddingId    String?
  wedding      Wedding?      @relation(fields: [weddingId], references: [id])
  payments     Payment[]
  paymentLinks PaymentLink[]

  // Commercial V1: the accepted commercial agreement this invoice belongs to. The accepted quotation is immutable, so
  // its line items, prices, discount, tax, total, advance and terms are read through this relation rather than copied.
  kind        InvoiceKind @default(OTHER)
  quotationId String?
  quotation   Quotation?  @relation("InvoiceQuotation", fields: [quotationId], references: [id])
  bookingId   String?
  booking     Booking?    @relation(fields: [bookingId], references: [id])
  issuedAt    DateTime? // when it was issued to the customer (DRAFT → SENT)

  // Production-hardening audit (2026-09-17) — every Wedding Workspace page
  // load queries this by weddingId, ordered by createdAt; Postgres doesn't
  // auto-index FK columns. Found during this pass — not in the original
  // audit's enumerated list, but the identical gap on the same query path.
  // The quotation whose advance this invoice was created from (at most one).
  advanceForQuotation Quotation? @relation("QuotationAdvanceInvoice")

  // At most one ADVANCE and one BALANCE invoice per quotation (NULL quotationId — manual invoices — never clash).
  @@unique([quotationId, kind])
  @@index([weddingId, createdAt])
  @@index([quotationId])
  @@index([bookingId])
  // Record ownership (docs/wedding-os/15-record-ownership.md). Phase A: every row belongs to Shaadi Shopping by default; Phase B
  // removes the default and every query is scoped by the logged-in business.
  businessId String   @default("shaadi-shopping")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@index([businessId])
  @@map("invoices")
}

model InvoiceItem {
  id            String  @id @default(uuid())
  legacyMongoId String? @unique
  invoiceId     String
  invoice       Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description   String
  vendorName    String?
  amount        Int
  quantity      Int     @default(1)

  @@map("invoice_items")
}

