// =====================================================================
// CRM (Phase B additions — docs/wedding-os/02-crm.md)
// Lead/Enquiry/Consultation stay separate capture tables (Phase A decision,
// reaffirmed in domain-model.md) but share this pipeline shape.
// =====================================================================

enum PipelineStage {
  NEW
  CONTACTED
  QUALIFIED
  SITE_VISIT_SCHEDULED
  QUOTATION_SENT
  NEGOTIATION
  // Commercial V1: the customer has accepted a quotation but the booking is not confirmed yet ("Accepted — booking
  // pending"). Set automatically by recording the acceptance; never picked by hand.
  ACCEPTED
  // Displays as "Booked": the booking is confirmed and the wedding exists. Set automatically at conversion.
  WON
  LOST
  // Sprint 5.3 — pause state, not terminal; resumes to any active stage.
  // Displays as "On Hold" — see components/crm/types.ts's STAGE_LABELS.
  ON_HOLD
}

// Sprint 5.3 — closed set for the LOST transition (docs/wedding-os/02-crm.md
// state machine). OTHER pairs with Lead/Enquiry/Consultation.lostReasonDetail.
enum LostReason {
  BUDGET_ISSUE
  DATE_UNAVAILABLE
  CHOSE_COMPETITOR
  NO_RESPONSE
  OTHER
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  // A newer revision was sent — the old one is kept as history, never edited.
  SUPERSEDED
}

// Quotation workflow (docs/wedding-os/08-quotation.md). Money is integer rupees
// like Invoice; totals are ALWAYS recomputed server-side (lib/quotation/totals.ts) —
// the API never accepts subtotal/total from a client. Tax is a typed amount, never
// an auto-percentage (06-finance.md §5); V1 applies no tax to the advance invoice.
//
// DB-level guarantees added by hand in the migration (Prisma can't express them):
//  - CHECK: exactly one of leadId/enquiryId/consultationId is set;
//  - partial unique index: at most one open (DRAFT/SENT) quotation per source;
//  - partial unique index: at most one ACCEPTED quotation per source.
model Quotation {
  id              String     @id @default(uuid())
  quotationNumber String     @unique // QTN-YYYYMM-NNNN, same scheme as INV-/WED-
  revision        Int        @default(1)
  supersedesId    String?    @unique // the revision this one replaces
  supersedes      Quotation? @relation("QuotationRevision", fields: [supersedesId], references: [id])
  supersededBy    Quotation? @relation("QuotationRevision")

  // Exactly one of these three is set (enforced by a DB CHECK constraint).
  leadId         String?
  // onDelete: Restrict — a source with quotations cannot be deleted (SET NULL would
  // violate the exactly-one-source CHECK); the delete guards return a clear message.
  lead           Lead?         @relation(fields: [leadId], references: [id], onDelete: Restrict)
  enquiryId      String?
  enquiry        Enquiry?      @relation(fields: [enquiryId], references: [id], onDelete: Restrict)
  consultationId String?
  consultation   Consultation? @relation(fields: [consultationId], references: [id], onDelete: Restrict)

  status        QuotationStatus @default(DRAFT)
  subtotal      Int // Σ unitPrice × quantity (server-computed)
  discount      Int             @default(0)
  gstEnabled    Boolean         @default(false) // NOT defaulted on — a compliance question, see 06-finance.md §5
  gstAmount     Int             @default(0) // typed by staff, like Invoice.gstAmount
  total         Int // subtotal − discount + gstAmount (server-computed)
  advanceAmount Int             @default(0) // 0 ≤ advance ≤ total; balance is derived, never stored
  validUntil    DateTime?
  terms         String?
  inclusions    String? // "What's included" — shown to the couple on the proposal page
  exclusions    String? // "What's not included" — shown to the couple on the proposal page
  notes         String? // internal, never shown to the customer
  pdfUrl        String? // reserved; no PDF generation in V1
  // Proposal link (docs/wedding-os/08-quotation.md §15). Only the SHA-256 of the random token is stored; the raw
  // link is shown to staff once. One link per revision; revising clears the original's hash so it can never revive.
  customerTokenHash      String?   @unique
  customerTokenCreatedAt DateTime?
  customerViewedAt       DateTime? // first time the couple opened the proposal
  changesRequestedAt     DateTime? // latest open "request changes" from the couple; never modifies the content
  changesRequestNote     String?

  sentAt          DateTime?
  acceptedAt      DateTime?
  acceptedById    String?
  acceptedBy      User?     @relation("QuotationAcceptedBy", fields: [acceptedById], references: [id])
  acceptedChannel String? // WHATSAPP | PHONE | IN_PERSON | OTHER — recorded by staff (no customer login in V1)
  acceptedNote    String?
  rejectedAt      DateTime?
  rejectionReason String?

  // Idempotency anchor for the automatic advance invoice created inside the
  // booking/lead → wedding conversion transaction (unique → at most one).
  advanceInvoiceId String?              @unique
  advanceInvoice   Invoice?             @relation("QuotationAdvanceInvoice", fields: [advanceInvoiceId], references: [id])
  invoices         Invoice[]            @relation("InvoiceQuotation") // every invoice raised against this agreement (advance, balance)
  booking          Booking? // one Booking per quotation (Booking.quotationId is unique)
  agreement        CommercialAgreement? // the frozen commercial terms this quotation was accepted on (money v1)

  items       QuotationItem[]
  createdById String?
  createdBy   User?           @relation("QuotationCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // Postgres doesn't auto-index FK columns; the source lookups are this panel's
  // hot path, and (status, validUntil) drives expiry checks.
  @@index([leadId])
  @@index([enquiryId])
  @@index([consultationId])
  @@index([status, validUntil])
  vendorEnquiries VendorEnquiry[]

  // Record ownership (docs/wedding-os/15-record-ownership.md). Phase A: every row belongs to Shaadi Shopping by default; Phase B
  // removes the default and every query is scoped by the logged-in business.
  businessId String   @default("shaadi-shopping")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@index([businessId])
  @@map("quotations")
}

model QuotationItem {
  id            String    @id @default(uuid())
  quotationId   String
  quotation     Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  sortOrder     Int
  description   String // e.g. "Grand Ballroom — 500 guests"
  category      String? // Venue / Catering / Decoration …
  functionLabel String? // e.g. "Sangeet" — informational until a Wedding exists
  vendorId      String? // null = custom line; a vendor is assigned after conversion
  vendor        Vendor?   @relation(fields: [vendorId], references: [id])
  unitPrice     Int
  quantity      Int       @default(1)

  @@index([quotationId])
  @@index([vendorId])
  @@map("quotation_items")
}

// docs/wedding-os/02-crm.md "AI insight storage" — a separate, versioned
// entity rather than nullable columns on Lead/Enquiry/Consultation, so
// regenerating a summary doesn't silently overwrite history and AI vs.
// human provenance stays auditable via generatedBy.
enum InsightGeneratedBy {
  AI
  HUMAN
}

model LeadInsight {
  id String @id @default(uuid())

  // Exactly one of these three is set (application-enforced), same pattern as Quotation.
  leadId         String?
  lead           Lead?         @relation(fields: [leadId], references: [id])
  enquiryId      String?
  enquiry        Enquiry?      @relation(fields: [enquiryId], references: [id])
  consultationId String?
  consultation   Consultation? @relation(fields: [consultationId], references: [id])

  generatedBy InsightGeneratedBy
  // Specific provenance (e.g. "manual", "gpt-5") — generatedBy is the coarse AI/HUMAN category.
  source      String?
  summary     String
  nextAction  String?
  sentiment   String?
  confidence  Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("lead_insights")
}

// =====================================================================
// Wedding OS (Phase B — docs/wedding-os/03-wedding-workspace.md and friends)
// Wedding is the aggregate root; see docs/wedding-os/domain-model.md §3.
// =====================================================================

enum WeddingStatus {
  PLANNING
  ACTIVE
  // Resumable, like ON_HOLD in PipelineStage — a stalled wedding needs to stay
  // visible as stalled on dashboards, not silently look identical to normal
  // progress just because a WeddingEvent.date got pushed back. Decided
  // 2026-07-22, domain-model.md §5.2.
  POSTPONED
  COMPLETED
  CANCELLED
}

// NOT a health indicator (ON_TRACK/AT_RISK/etc.) — that's computed from
// ActivityLog + child entity state at read time, per the "store events, not
// dashboard state" principle. This is the Wedding's actual lifecycle stage.
enum WeddingSource {
  CRM
  BOOKING
}

model Wedding {
  id            String        @id @default(uuid())
  weddingNumber String        @unique // human-readable reference, e.g. WED-2026-0001
  status        WeddingStatus @default(PLANNING)
  source        WeddingSource
  primaryDate   DateTime // convenience cache of the main event's date — WeddingEvent rows are the source of truth
  city          String
  guestCount    Int?
  weddingType   String?
  totalBudget   Int? // planned budget; seeded from Consultation.totalBudget or Booking.total, editable after

  // Exactly one of these four is set, matching WeddingSource — the two live
  // conversion paths resolved in domain-model.md §5. @unique enforces one
  // Wedding per source record (a Lead can't spawn two Weddings).
  sourceLeadId         String?       @unique
  sourceLead           Lead?         @relation(fields: [sourceLeadId], references: [id])
  sourceEnquiryId      String?       @unique
  sourceEnquiry        Enquiry?      @relation(fields: [sourceEnquiryId], references: [id])
  sourceConsultationId String?       @unique
  sourceConsultation   Consultation? @relation(fields: [sourceConsultationId], references: [id])
  sourceBookingId      String?       @unique
  sourceBooking        Booking?      @relation(fields: [sourceBookingId], references: [id])

  customerId    String?
  customer      User?   @relation("WeddingCustomer", fields: [customerId], references: [id])
  coordinatorId String?
  coordinator   User?   @relation("WeddingCoordinator", fields: [coordinatorId], references: [id])

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  // Distinct from `updatedAt` (which any field edit touches) — needed for
  // "time from creation to completion" reporting. Found during the Step 4
  // workflow review (Wedding Completion), added directly rather than flagged
  // since it's a safe, uncontroversial addition.
  completedAt DateTime?

  couple             Couple?
  events             WeddingEvent[]
  tasks              Task[]
  activities         ActivityLog[]
  documents          Document[]
  invoices           Invoice[]
  timelineMilestones TimelineMilestone[]
  reviews            Review[]
  aiConversations    AiConversation[]
  approvals          ApprovalRequest[]   @relation("ApprovalWedding")
  guests             Guest[]

  // Record ownership (docs/wedding-os/15-record-ownership.md). Phase A: every row belongs to Shaadi Shopping by default; Phase B
  // removes the default and every query is scoped by the logged-in business.
  businessId String   @default("shaadi-shopping")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@index([businessId])
  @@map("weddings")
}

model Couple {
  id                String   @id @default(uuid())
  weddingId         String   @unique
  wedding           Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  brideName         String?
  bridePhone        String?
  groomName         String?
  groomPhone        String?
  familyContacts    Json? // flexible [{name, relation, phone}] list — a rigid sub-table is unwarranted for v1
  preferredLanguage String?
  preferences       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("couples")
}

enum WeddingEventType {
  ENGAGEMENT
  HALDI
  MEHNDI
  SANGEET
  WEDDING
  RECEPTION
  OTHER
}

model WeddingEvent {
  id           String           @id @default(uuid())
  weddingId    String
  wedding      Wedding          @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  type         WeddingEventType
  label        String? // overrides the default type label — required in practice when type=OTHER
  date         DateTime
  startTime    String? // simple "18:00"-style string — a full TZ-aware time type is unwarranted for v1
  venueName    String?
  venueAddress String?
  city         String
  budget       Int? // planned budget for THIS event; Wedding.totalBudget is the rollup, not duplicated here
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  vendorBookings VendorBooking[]
  tasks          Task[]
  approvals      ApprovalRequest[]
  guestResponses GuestFunctionResponse[]

  // Production-hardening audit (2026-09-17) — every Wedding Workspace page
  // load queries this by weddingId, ordered by date; Postgres doesn't
  // auto-index FK columns. Same class already fixed for Guest/ActivityLog.
  @@index([weddingId, date])
  @@map("wedding_events")
}

enum GuestRsvpStatus {
  PENDING
  ATTENDING
  NOT_ATTENDING
  MAYBE
}

model Guest {
  id                 String          @id @default(uuid())
  weddingId          String
  wedding            Wedding         @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  name               String
  phone              String?
  email              String?
  category           String?
  accompanyingGuests Int             @default(0)
  rsvpStatus         GuestRsvpStatus @default(PENDING)
  notes              String?
  rsvpToken          String          @unique @default(uuid())
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  functionResponses GuestFunctionResponse[]

  @@index([weddingId, rsvpStatus])
  @@map("guests")
}

model GuestFunctionResponse {
  id             String          @id @default(uuid())
  guestId        String
  guest          Guest           @relation(fields: [guestId], references: [id], onDelete: Cascade)
  weddingEventId String
  weddingEvent   WeddingEvent    @relation(fields: [weddingEventId], references: [id], onDelete: Cascade)
  status         GuestRsvpStatus @default(PENDING)
  updatedAt      DateTime        @updatedAt

  @@unique([guestId, weddingEventId])
  @@index([weddingEventId, status])
  @@map("guest_function_responses")
}

// Vendor enquiry (blueprint §43, docs/wedding-os/04-vendor-os.md §9): when staff link a vendor to a customer — on
// the consultation or on a quote line — the vendor is asked, asynchronously, whether they can take it. Never blocks
// sales; the customer never sees it. Created before any booking or wedding exists (a VendorBooking comes later).
enum VendorEnquiryStatus {
  PENDING // asked, no answer yet
  AVAILABLE
  AVAILABLE_WITH_CONDITIONS
  NOT_AVAILABLE
  ALTERNATE_DATE // vendor suggests another date
  QUOTED // vendor sent their package / quote
  WITHDRAWN // the vendor is no longer linked to this customer — nothing more is needed from them
}

model VendorEnquiry {
  id        String @id @default(uuid())
  vendorId  String
  vendor    Vendor @relation("VendorEnquiries", fields: [vendorId], references: [id], onDelete: Restrict)
  // "CONSULTATION:<id>" / "ENQUIRY:<id>" / "LEAD:<id>" — one enquiry per vendor per customer record (unique below;
  // the three nullable source columns alone could not enforce it).
  sourceKey String

  leadId         String?
  lead           Lead?         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  enquiryId      String?
  enquiry        Enquiry?      @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  consultationId String?
  consultation   Consultation? @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  quotationId    String? // the quote that last linked this vendor, if any
  quotation      Quotation?    @relation(fields: [quotationId], references: [id], onDelete: SetNull)

  // What the vendor is asked — operational facts only, never the couple's identity or the customer price.
  services   String // "Venue, Decoration"
  functions  String? // "Wedding, Reception"
  eventDate  String? // as the customer gave it
  guestCount Int?
  city       String?
  eventType  String?

  status          VendorEnquiryStatus @default(PENDING)
  responseNote    String?
  suggestedDate   String?
  quotedAmount    Int?
  responseChannel String? // VENDOR_OS, or how staff heard it: PHONE / WHATSAPP / IN_PERSON / OTHER
  respondedAt     DateTime?
  respondedById   String?
  respondedBy     User?     @relation("VendorEnquiryAnsweredBy", fields: [respondedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([vendorId, sourceKey])
  @@index([vendorId, status])
  @@index([sourceKey])
  @@map("vendor_enquiries")
}

enum VendorBookingStatus {
  PENDING_VENDOR_CONFIRMATION
  CONFIRMED
  DECLINED
  // Only used if the "coordinator proposes, customer approves" UX direction
  // from docs/wedding-os/05-customer-portal.md §3 is the one chosen — included
  // now so Step 3 doesn't need a second migration if it is.
  CUSTOMER_APPROVAL_PENDING
  CANCELLED
  COMPLETED
}

enum VenueBookingStatus {
  PENDING
  READY_FOR_SETUP
  SETUP_IN_PROGRESS
  READY
  COMPLETED
}

model VendorBooking {
  id              String              @id @default(uuid())
  weddingEventId  String
  weddingEvent    WeddingEvent        @relation(fields: [weddingEventId], references: [id], onDelete: Cascade)
  vendorId        String
  vendor          Vendor              @relation(fields: [vendorId], references: [id])
  vendorPackageId String?
  vendorPackage   VendorPackage?      @relation(fields: [vendorPackageId], references: [id])
  status          VendorBookingStatus @default(PENDING_VENDOR_CONFIRMATION)
  venueStatus     VenueBookingStatus  @default(PENDING)
  agreedPrice     Int
  declineReason   String?
  respondedAt     DateTime? // vendor's accept/decline timestamp — feeds Vendor Score's response-time component
  onTimeService   Boolean? // set post-event; feeds Vendor Score's on-time component (docs/wedding-os/04-vendor-os.md §7)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  tasks      Task[]
  activities ActivityLog[]
  documents  Document[]
  payouts    Payout[]

  @@map("vendor_bookings")
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  DONE
  BLOCKED
}

model TimelineMilestone {
  id          String              @id @default(uuid())
  weddingId   String
  wedding     Wedding             @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  label       String // e.g. "Venue Booked" — the default 11-step sequence in 03-wedding-workspace.md §3 is a starting template, not a fixed schema
  sortOrder   Int
  ownerId     String?
  owner       User?               @relation(fields: [ownerId], references: [id])
  dueDate     DateTime?
  status      MilestoneStatus     @default(PENDING)
  // v1 supports a single upstream dependency per milestone, not a full DAG —
  // sufficient for a linear-with-occasional-branches timeline, revisit if a
  // real wedding needs more complex dependency graphs than this expresses.
  dependsOnId String?
  dependsOn   TimelineMilestone?  @relation("MilestoneDependency", fields: [dependsOnId], references: [id])
  dependents  TimelineMilestone[] @relation("MilestoneDependency")
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  // Production-hardening audit (2026-09-17) — every Wedding Workspace page
  // load queries this by weddingId, ordered by sortOrder; Postgres doesn't
  // auto-index FK columns.
  @@index([weddingId, sortOrder])
  @@map("timeline_milestones")
}

enum DocumentCategory {
  CONTRACT
  QUOTATION
  INVOICE
  ID_PROOF
  VENUE_AGREEMENT
  FLOOR_PLAN
  MENU
  RECEIPT
  OTHER
}

enum DocumentVisibility {
  INTERNAL
  CUSTOMER_VISIBLE
}

model Document {
  id              String             @id @default(uuid())
  weddingId       String
  wedding         Wedding            @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  vendorBookingId String? // set for vendor-specific docs (quotations/receipts tied to one VendorBooking)
  vendorBooking   VendorBooking?     @relation(fields: [vendorBookingId], references: [id])
  category        DocumentCategory
  // Default INTERNAL is deliberate — a document must be explicitly marked
  // customer-visible, not accidentally exposed by omission. See
  // docs/wedding-os/05-customer-portal.md §3's Documents section.
  visibility      DocumentVisibility @default(INTERNAL)
  fileName        String
  url             String // Cloudinary URL — same upload pattern as every other image/file in this app, no new storage system
  uploadedById    String?
  uploadedBy      User?              @relation(fields: [uploadedById], references: [id])
  createdAt       DateTime           @default(now())

  // Production-hardening audit (2026-09-17) — every Wedding Workspace page
  // load queries this by weddingId, ordered by createdAt; Postgres doesn't
  // auto-index FK columns.
  @@index([weddingId, createdAt])
  @@map("documents")
}

// =====================================================================
// Shared / cross-context entities (docs/wedding-os/domain-model.md §1)
// Referenced by both CRM and Wedding contexts by design — unifying these
// avoids two near-identical, drifting systems (one per context).
// =====================================================================

enum TaskContext {
  SALES_FOLLOWUP
  WEDDING_TASK
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Task {
  id          String       @id @default(uuid())
  context     TaskContext
  title       String
  description String?
  status      TaskStatus   @default(PENDING)
  priority    TaskPriority @default(MEDIUM)
  dueAt       DateTime?
  completedAt DateTime?

  assignedToId String?
  assignedTo   User?   @relation("TaskAssignedTo", fields: [assignedToId], references: [id])
  createdById  String?
  createdBy    User?   @relation("TaskCreatedBy", fields: [createdById], references: [id])

  // Exactly one subject is set, matching `context` — SALES_FOLLOWUP tasks
  // reference one of lead/enquiry/consultation, WEDDING_TASK tasks reference
  // wedding (and optionally a specific event/vendorBooking within it).
  leadId          String?
  lead            Lead?          @relation(fields: [leadId], references: [id])
  enquiryId       String?
  enquiry         Enquiry?       @relation(fields: [enquiryId], references: [id])
  consultationId  String?
  consultation    Consultation?  @relation(fields: [consultationId], references: [id])
  weddingId       String?
  wedding         Wedding?       @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  weddingEventId  String?
  weddingEvent    WeddingEvent?  @relation(fields: [weddingEventId], references: [id])
  vendorBookingId String?
  vendorBooking   VendorBooking? @relation(fields: [vendorBookingId], references: [id])

  // Per docs/wedding-os/07-ai-assistant.md — AI can suggest (Level 2) but not
  // create unilaterally in v1; a suggested Task should go through
  // ApprovalRequest before this flag is trusted as "a human signed off."
  aiSuggested Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Production-hardening audit (2026-09-17) — every Wedding Workspace page
  // load queries this by weddingId, ordered by createdAt; Postgres doesn't
  // auto-index FK columns. Task's other subject FKs (leadId/enquiryId/
  // consultationId/weddingEventId/vendorBookingId) are a separate, lower-
  // traffic finding from the same audit — not addressed here.
  @@index([weddingId, createdAt])
  @@map("tasks")
}

enum ActivityType {
  CALL
  WHATSAPP
  EMAIL
  MEETING
  NOTE // "Notes" from early sketches — modeled as an entry type here, not a 4th table (domain-model.md §4)
  // System-generated event types — this list is what fulfills "store events,
  // not state" in practice. Extend this enum, don't add parallel status columns.
  STATUS_CHANGED
  VENDOR_CONFIRMED
  VENDOR_DECLINED
  PAYMENT_RECEIVED
  TASK_CREATED
  TASK_COMPLETED
  TASK_OVERDUE
  TIMELINE_DELAYED
  DOCUMENT_UPLOADED
  AI_DRAFT_CREATED
  ASSIGNED // Sprint 5.3 — lead/enquiry/consultation reassignment
  APPROVAL_REQUESTED
  APPROVAL_APPROVED
  APPROVAL_CHANGES_REQUESTED
  APPROVAL_CANCELLED
  // Quotation workflow (08-quotation.md)
  QUOTATION_SENT
  QUOTATION_ACCEPTED
  QUOTATION_REJECTED
  QUOTATION_REVISED
  INVOICE_CREATED
  QUOTATION_CHANGES_REQUESTED // the couple asked for changes on the proposal page
  PROPOSAL_VIEWED // the couple opened the proposal link for the first time
  VENDOR_ENQUIRY_SENT // a vendor linked to this customer was asked for availability (04-vendor-os.md §9)
  VENDOR_ENQUIRY_ANSWERED // the vendor answered (in Vendor OS, or recorded by staff)
}

model ActivityLog {
  id      String       @id @default(uuid())
  type    ActivityType
  summary String // short human-readable line, e.g. "Vendor confirmed for Sangeet"
  detail  String? // longer note/body — call notes, AI draft content, etc.

  // Per docs/wedding-os/07-ai-assistant.md §3's guardrail: every AI-drafted
  // entry must be flagged as such, and if it was externally sent, who approved it.
  aiGenerated   Boolean @default(false)
  approvedById  String?
  approvedBy    User?   @relation("ActivityApprovedBy", fields: [approvedById], references: [id])
  performedById String?
  performedBy   User?   @relation("ActivityPerformedBy", fields: [performedById], references: [id])

  // Sprint 5.4 — structured mirror of a STATUS_CHANGED entry's stage
  // transition, populated only by leadWorkspace.service.ts's transitionStage().
  // `summary` stays the human-readable line; Pipeline Velocity and similar
  // analytics read these instead of parsing display text.
  fromStage PipelineStage?
  toStage   PipelineStage?

  // Same "exactly one subject" pattern as Task — spans pre- and
  // post-conversion so a coordinator never needs a separate CRM log.
  leadId          String?
  lead            Lead?          @relation(fields: [leadId], references: [id])
  enquiryId       String?
  enquiry         Enquiry?       @relation(fields: [enquiryId], references: [id])
  consultationId  String?
  consultation    Consultation?  @relation(fields: [consultationId], references: [id])
  weddingId       String?
  wedding         Wedding?       @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  vendorBookingId String?
  vendorBooking   VendorBooking? @relation(fields: [vendorBookingId], references: [id])

  // Deliberately no `updatedAt` — append-only/immutable by convention, the
  // event trail this system's Health Score and AI summaries derive from.
  createdAt DateTime @default(now())

  @@index([weddingId, createdAt])
  @@map("activity_logs")
}

enum ApprovalSubjectType {
  SERVICE_SELECTION
  DECORATION
  MENU
  DESIGN
  QUOTATION
  OTHER
  VENDOR_PROFILE_CHANGE
  AI_DRAFT
  CUSTOMER_VENDOR_APPROVAL
}

enum ApprovalStatus {
  DRAFT
  PENDING_CLIENT
  PENDING
  APPROVED
  CHANGES_REQUESTED
  CANCELLED
  REJECTED
}

// Unifies three previously-separate-sounding approval flows named across
// 04-vendor-os.md, 05-customer-portal.md, and 07-ai-assistant.md — one entity,
// three subject types, instead of three near-identical tables that would
// drift from each other over time. `subjectId` is resolved at the application
// layer based on `subjectType` (no DB-level polymorphic FK in Postgres).
model ApprovalRequest {
  id             String              @id @default(uuid())
  subjectType    ApprovalSubjectType
  subjectId      String
  title          String?
  description    String?
  amount         Int?
  deadline       DateTime?
  weddingId      String?
  wedding        Wedding?            @relation("ApprovalWedding", fields: [weddingId], references: [id], onDelete: Cascade)
  weddingEventId String?
  weddingEvent   WeddingEvent?       @relation(fields: [weddingEventId], references: [id], onDelete: SetNull)
  requestedById  String?
  requestedBy    User?               @relation("ApprovalRequestedBy", fields: [requestedById], references: [id])
  status         ApprovalStatus      @default(PENDING)
  approvedById   String?
  approvedBy     User?               @relation("ApprovalApprovedBy", fields: [approvedById], references: [id])
  approvedAt     DateTime?
  notes          String?
  clientComment  String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  // Resolves drift that's been silently re-excluded from three prior migrations (add_vendor_capability,
  // add_vendor_prospect, add_vendor_area) — these two indexes were created live by migration
  // 20260825000000_add_client_approvals but never declared here, so every unrelated schema change since
  // has had Prisma propose dropping them. Declaring them for real instead of excluding a fourth time.
  @@index([weddingId])
  @@index([weddingEventId])
  @@map("approval_requests")
}

// =====================================================================
// Finance (Phase B — docs/wedding-os/06-finance.md)
// Deliberately does NOT encode GST/tax treatment — only the data shape
// needed to support whatever structure a CA confirms. See the doc for why.
// =====================================================================

enum PaymentStatus {
  SUCCESS
  FAILED
  REFUNDED
}

model Payment {
  id                String        @id @default(uuid())
  invoiceId         String
  invoice           Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount            Int
  // Razorpay's method string (upi/card/netbanking/wallet/...) — kept as plain
  // text rather than a rigid enum since Razorpay's own method list can change
  // independent of this schema.
  method            String
  razorpayPaymentId String?       @unique
  razorpayOrderId   String?
  status            PaymentStatus @default(SUCCESS)
  paidAt            DateTime      @default(now())
  createdAt         DateTime      @default(now())

  // Money v1: who recorded a payment received outside Razorpay, and its bank / UPI reference (UTR). `receiptId` groups the rows one
  // receipt was split into (a payment larger than the advance invoice is applied to the balance invoice too); `idempotencyKey`
  // (unique) makes a double-submitted form a no-op.
  reference      String?
  recordedById   String?
  recordedBy     User?   @relation("PaymentRecordedBy", fields: [recordedById], references: [id])
  receiptId      String?
  idempotencyKey String? @unique

  @@index([receiptId])
  // Record ownership (docs/wedding-os/15-record-ownership.md). Phase A: every row belongs to Shaadi Shopping by default; Phase B
  // removes the default and every query is scoped by the logged-in business.
  businessId String   @default("shaadi-shopping")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@index([businessId])
  @@map("payments")
}

enum PaymentLinkStatus {
  CREATED
  PAID
  EXPIRED
  CANCELLED
}

// Sprint 7.2 — tracks a sent-but-not-yet-paid Razorpay Payment Link so admins
// can see "link sent, awaiting payment" without a fake/nullable Payment row.
// Payment stays "money that actually moved" (Sprint 7.1's rule); this is the
// pending-state table that rule implies is needed alongside it.
// Money v1 (docs/wedding-os/10-commercial-flow-v1.md, 22 Sep 2026). The commercial terms an accepted quotation was booked on, frozen
// when the booking is made: the total, the confirmation rule it was made under (percent, rounding, hold window) and the exact amount
// that rule required, what was accepted (items with their quotation-item ids, function labels, terms) and by whom. It is the
// booking-time protection — a later change to a venue's default terms, a vendor price, or the business rules never re-prices a deal.
//
// It stores NO money that moves: what was received is always summed from Payment rows, and "Date Held" / "Confirmed" are derived
// from that (lib/commercial/rules.ts). The only operational timestamps kept are the hold window's start/end (set once, by the first
// payment) and the moment the booking was confirmed. One per accepted quotation; the booking is optional because a CRM lead whose
// quotation was accepted has no Booking.
model CommercialAgreement {
  id                   String    @id @default(uuid())
  quotationId          String    @unique
  quotation            Quotation @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  quotationRevision    Int
  bookingId            String?   @unique
  booking              Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  customerId           String?
  customerName         String
  customerPhone        String
  currency             String    @default("INR")
  subtotal             Int
  discountAmount       Int
  taxAmount            Int
  agreementTotal       Int
  confirmationPercent  Int
  confirmationAmount   Int
  confirmationRounding String
  holdWindowDays       Int
  termsSnapshot        String?
  itemsSnapshot        Json
  functionLabels       Json
  acceptedAt           DateTime?
  acceptedById         String?
  holdStartedAt        DateTime?
  holdExpiresAt        DateTime?
  confirmedAt          DateTime?
  createdAt            DateTime  @default(now())

  // Record ownership (docs/wedding-os/15-record-ownership.md). Phase A: every row belongs to Shaadi Shopping by default; Phase B
  // removes the default and every query is scoped by the logged-in business.
  businessId String   @default("shaadi-shopping")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@index([businessId])
  @@map("commercial_agreements")
}

model PaymentLink {
  id                    String            @id @default(uuid())
  invoiceId             String
  invoice               Invoice           @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  razorpayPaymentLinkId String            @unique
  shortUrl              String
  amount                Int
  status                PaymentLinkStatus @default(CREATED)
  expiresAt             DateTime?
  createdById           String?
  createdBy             User?             @relation(fields: [createdById], references: [id])
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@map("payment_links")
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

model Payout {
  id               String        @id @default(uuid())
  vendorBookingId  String
  vendorBooking    VendorBooking @relation(fields: [vendorBookingId], references: [id])
  vendorId         String
  vendor           Vendor        @relation(fields: [vendorId], references: [id])
  grossAmount      Int // VendorBooking.agreedPrice at time of payout
  // Rate is a snapshot at payout time, not a live reference to CommissionRate —
  // so a later rate-config change never silently rewrites historical payouts.
  commissionRate   Float
  commissionAmount Int
  netAmount        Int
  status           PayoutStatus  @default(PENDING)
  payoutBatchId    String?
  payoutBatch      PayoutBatch?  @relation(fields: [payoutBatchId], references: [id])
  paidAt           DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  // Sprint 7.3 — one payout per booking; app-level eligibility checks in
  // payout.service.ts are backed by this DB-level constraint against a race.
  @@unique([vendorBookingId])
  @@map("payouts")
}

// Only meaningful if payouts end up cyclical/batched rather than per-booking —
// docs/wedding-os/06-finance.md flags payout timing as still an open business
// decision. Included now so Step 3 doesn't need a second migration either way.
model PayoutBatch {
  id          String    @id @default(uuid())
  status      String    @default("PENDING")
  totalAmount Int
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  payouts Payout[]

  @@map("payout_batches")
}

// null categoryId = the global default rate. Only needed if commission varies
// by category — docs/wedding-os/06-finance.md §4 flags this as undecided;
// modeled now so both a flat and a per-category rate are representable.
model CommissionRate {
  id            String    @id @default(uuid())
  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id])
  rate          Float // percentage, e.g. 10.0 = 10%
  effectiveFrom DateTime  @default(now())
  createdAt     DateTime  @default(now())

  @@map("commission_rates")
}

// Route A (marketplace/commission) commercial relationship — which partner tier a vendor is
// on. Versioned the same way CommissionRate is above: a tier change is a NEW row with a later
// effectiveFrom, never an edit to an existing one. "Currently effective" is resolved at query
// time (most recent row with effectiveFrom <= now, same shape as
// commissionRateRepository.findCurrentRate), not a stored boolean — so there's no
// isCurrent/isActive flag to keep in sync. Deliberately has NO relation to CommissionRate yet —
// whether/how tier feeds commission resolution is a separate, explicitly undecided question
// (see the 2026-09-23 business-model architecture audit); this model only establishes which
// tier a vendor is on and its history, nothing downstream reads it yet.
enum PartnerTier {
  PARTNER
  GROWTH_PARTNER
  PREMIUM_PARTNER
}

model PartnerAgreement {
  id            String      @id @default(uuid())
  vendorId      String
  vendor        Vendor      @relation(fields: [vendorId], references: [id])
  tier          PartnerTier
  effectiveFrom DateTime    @default(now())
  createdAt     DateTime    @default(now())

  @@map("partner_agreements")
}

// =====================================================================
// Vendor OS (Phase B — docs/wedding-os/04-vendor-os.md)
// =====================================================================

enum AvailabilityStatus {
  AVAILABLE
  TENTATIVE
  BOOKED
  BLOCKED
}

model VendorAvailability {
  id        String             @id @default(uuid())
  vendorId  String
  vendor    Vendor             @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  date      DateTime           @db.Date
  status    AvailabilityStatus @default(AVAILABLE)
  note      String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([vendorId, date])
  @@map("vendor_availability")
}

model Review {
  id         String   @id @default(uuid())
  vendorId   String
  vendor     Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  weddingId  String?
  wedding    Wedding? @relation(fields: [weddingId], references: [id])
  authorName String
  rating     Int // 1-5
  comment    String?
  createdAt  DateTime @default(now())

  @@map("reviews")
}

// Isolated from Vendor deliberately — sensitive/regulated data (bank/UPI
// details) benefits from its own table with stricter access control, not just
// a flag on the main Vendor record. Application layer must encrypt at rest;
// Prisma does not do this automatically. See docs/wedding-os/06-finance.md §3.
model VendorPaymentDetails {
  id                String   @id @default(uuid())
  vendorId          String   @unique
  vendor            Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  accountHolderName String?
  // SECURITY: deliberately unused today — confirmed 2026-09-01 that no
  // repository, service, API route, or admin/vendor-portal UI anywhere
  // reads or writes this model (payouts are calculation + manual
  // PENDING->PAID tracking only, see payout.service.ts; payout timing/
  // disbursement is still an open decision, docs/wedding-os/06-finance.md
  // §"open questions"). DO NOT wire bankAccountNumber into any code path
  // without column-level encryption at rest first.
  bankAccountNumber String?
  ifscCode          String?
  upiId             String?
  gstin             String? // docs/wedding-os/06-finance.md §5 — pending CA confirmation of actual usage
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("vendor_payment_details")
}

// =====================================================================
// AI (Phase B — docs/wedding-os/07-ai-assistant.md)
// v1 scope is Level 1 (Assistant) + Level 2 (Copilot) only — this table logs
// every AI interaction regardless of level, for the same audit-trail reason
// ActivityLog.aiGenerated exists.
// =====================================================================

enum AiConversationChannel {
  CUSTOMER_QA
  SALES_DRAFT
  VENDOR_DRAFT
  SUMMARY
}

model AiConversation {
  id        String                @id @default(uuid())
  channel   AiConversationChannel
  weddingId String?
  wedding   Wedding?              @relation(fields: [weddingId], references: [id])
  userId    String?
  user      User?                 @relation(fields: [userId], references: [id])
  prompt    String
  response  String
  createdAt DateTime              @default(now())

  @@map("ai_conversations")
}

// =====================================================================
// Notifications — surfaced in this pass because 04/05/07 all named
// "reminder"/"alert"/"notify" behaviors without a delivery mechanism behind
// them. Distinct from ActivityLog: ActivityLog records what happened,
// Notification is about alerting a specific user about it.
// =====================================================================

enum NotificationChannel {
  IN_APP
  WHATSAPP
  EMAIL
  PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  READ
  FAILED
}

model Notification {
  id        String              @id @default(uuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id])
  channel   NotificationChannel
  title     String
  body      String
  status    NotificationStatus  @default(PENDING)
  readAt    DateTime?
  sentAt    DateTime?
  // Loose reference, not a hard FK — a notification can be about many kinds of
  // subject (wedding, task, payment reminder); resolved at the application layer.
  weddingId String?
  taskId    String?
  createdAt DateTime            @default(now())

  @@map("notifications")
}

// ---- Growth Partner Program (docs/wedding-os/14-growth-partner.md) -----------------------------------------------
// People with wedding-industry contacts register as Growth Partners and refer venues, vendors, clients or events.
// V1 is operationally simple: staff verify every partner and referral by hand, and enter any payout themselves.

enum GrowthPartnerStatus {
  NEW
  UNDER_REVIEW
  APPROVED
  REJECTED
  INACTIVE
}

enum PartnerReferralType {
  VENUE
  VENDOR
  CLIENT
  EVENT
}

enum PartnerReferralStatus {
  SUBMITTED
  VERIFIED
  CONTACTED
  IN_DISCUSSION
  CONVERTED
  COMPLETED
  PAID
  REJECTED
}

enum PartnerPayoutStatus {
  NOT_DUE
  DUE
  PAID
}

model GrowthPartner {
  id            String              @id @default(uuid())
  code          String              @unique // "GP-1001" — shown once on registration; with the mobile it identifies the partner on referrals
  name          String
  phone         String              @unique // 10-digit Indian mobile
  whatsapp      String?
  email         String?
  city          String
  category      String // "Event Planner / Coordinator", … (what best describes them)
  referralTypes String[] // venues / vendors / clients / events / multiple
  networkNote   String?
  consentAt     DateTime // agreed to be contacted about the program
  status        GrowthPartnerStatus @default(NEW)
  staffNotes    String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  referrals PartnerReferral[]

  @@index([status])
  @@index([city])
  @@map("growth_partners")
}

model PartnerReferral {
  id            String                @id @default(uuid())
  partnerId     String
  partner       GrowthPartner         @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  type          PartnerReferralType
  name          String // person or business name
  phone         String
  city          String
  requirement   String?
  notes         String? // from the partner
  consentAt     DateTime // the partner confirmed the referral agreed to be contacted
  status        PartnerReferralStatus @default(SUBMITTED)
  assignedToId  String?
  assignedTo    User?                 @relation("PartnerReferralAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  completedAt   DateTime?
  payoutStatus  PartnerPayoutStatus   @default(NOT_DUE)
  payoutAmount  Int? // rupees, entered by staff — no automatic rates in V1
  paidAt        DateTime?
  staffNotes    String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([partnerId])
  @@index([status])
  @@index([type])
  @@map("partner_referrals")
}

// ---------- Record ownership (docs/wedding-os/15-record-ownership.md, approved 4 Oct 2026) ----------

enum BusinessKind {
  PLATFORM // Shaadi Shopping itself — exactly one, id "shaadi-shopping"
  VENDOR // a venue or vendor running its own business in Vivah OS
}

// Blueprint §13: the vendor's commercial relationship, as structured data. Null for the platform.
enum CommercialStatus {
  COMMISSION_PARTNER
  SAAS
  BOTH
  MARKETPLACE_ONLY
  INACTIVE
}

enum BusinessRole {
  OWNER // everything, including money, staff and settings
  STAFF // enquiries, quotations, weddings — not settings or payouts
}

// Every customer record belongs to exactly one Business (D1). A venue's own records are private to it (D3).
model Business {
  id               String            @id @default(uuid())
  name             String
  kind             BusinessKind
  commercialStatus CommercialStatus?
  vendorId         String?           @unique // its public listing, if it has one
  vendor           Vendor?           @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  numberPrefix     String?           @unique // per-business document numbers (D6); null = the platform's QTN- / INV- / WED-
  upiId            String? // where its customers pay (D7); the platform still uses SHAADI_UPI_ID until Phase D
  upiName          String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  members               BusinessMember[]
  leads                 Lead[]
  enquiries             Enquiry[]
  consultations         Consultation[]
  quotations            Quotation[]
  bookings              Booking[]
  commercialAgreements  CommercialAgreement[]
  weddings              Wedding[]
  invoices              Invoice[]
  payments              Payment[]

  @@map("businesses")
}

// A login working in a business (D2: venues can have several). Nothing reads this until Phase B.
model BusinessMember {
  id         String       @id @default(uuid())
  businessId String
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       BusinessRole
  createdAt  DateTime     @default(now())

  @@unique([businessId, userId])
  @@index([userId])
  @@map("business_members")
}
