// =====================================================================
// CRM (Phase B additions — docs/wedding-os/02-crm.md)
// Lead/Enquiry/Consultation stay separate capture tables (Phase A decision,
// reaffirmed in domain-model.md) but share this pipeline shape.
// =====================================================================

enum PipelineStage {
  NEW
  CONTACTED
  QUALIFIED
  SITE_VISIT_SCHEDULED
  QUOTATION_SENT
  NEGOTIATION
  // Commercial V1: the customer has accepted a quotation but the booking is not confirmed yet ("Accepted — booking
  // pending"). Set automatically by recording the acceptance; never picked by hand.
  ACCEPTED
  // Displays as "Booked": the booking is confirmed and the wedding exists. Set automatically at conversion.
  WON
  LOST
  // Sprint 5.3 — pause state, not terminal; resumes to any active stage.
  // Displays as "On Hold" — see components/crm/types.ts's STAGE_LABELS.
  ON_HOLD
}

// Sprint 5.3 — closed set for the LOST transition (docs/wedding-os/02-crm.md
// state machine). OTHER pairs with Lead/Enquiry/Consultation.lostReasonDetail.
enum LostReason {
  BUDGET_ISSUE
  DATE_UNAVAILABLE
  CHOSE_COMPETITOR
  NO_RESPONSE
  OTHER
}

enum QuotationStatus {
  DRAFT
  // CRM: the client link exists and WhatsApp was opened with it, but staff have not yet confirmed they pressed Send.
  // Only that confirmation makes it SENT; "not sent" puts it back to DRAFT and stops the link (20 Nov 2026).
  READY_TO_SHARE
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  // A newer revision was sent — the old one is kept as history, never edited.
  SUPERSEDED
}

// Quotation workflow (docs/wedding-os/08-quotation.md). Money is integer rupees
// like Invoice; totals are ALWAYS recomputed server-side (lib/quotation/totals.ts) —
// the API never accepts subtotal/total from a client. Tax is a typed amount, never
// an auto-percentage (06-finance.md §5); V1 applies no tax to the advance invoice.
//
// DB-level guarantees added by hand in the migration (Prisma can't express them):
//  - CHECK: exactly one of leadId/enquiryId/consultationId is set;
//  - partial unique index: at most one open (DRAFT/SENT) quotation per source;
//  - partial unique index: at most one ACCEPTED quotation per source.
model Quotation {
  confirmations Confirmation[] // services confirmed from it (PR 8)
  id              String     @id @default(uuid())
  quotationNumber String     @unique // QTN-YYYYMM-NNNN, same scheme as INV-/WED-
  revision        Int        @default(1)
  supersedesId    String?    @unique // the revision this one replaces
  supersedes      Quotation? @relation("QuotationRevision", fields: [supersedesId], references: [id])
  supersededBy    Quotation? @relation("QuotationRevision")

  // Exactly one of these three is set (enforced by a DB CHECK constraint).
  leadId         String?
  // onDelete: Restrict — a source with quotations cannot be deleted (SET NULL would
  // violate the exactly-one-source CHECK); the delete guards return a clear message.
  lead           Lead?         @relation(fields: [leadId], references: [id], onDelete: Restrict)
  enquiryId      String?
  enquiry        Enquiry?      @relation(fields: [enquiryId], references: [id], onDelete: Restrict)
  consultationId String?
  consultation   Consultation? @relation(fields: [consultationId], references: [id], onDelete: Restrict)

  status        QuotationStatus @default(DRAFT)
  subtotal      Int // Σ unitPrice × quantity (server-computed)
  discount      Int             @default(0)
  gstEnabled    Boolean         @default(false) // NOT defaulted on — a compliance question, see 06-finance.md §5
  gstAmount     Int             @default(0) // typed by staff, like Invoice.gstAmount
  // The business's GST number, frozen on the quotation when it is saved (founder, 7 Oct 2026): a later change to the business
  // profile never changes a quotation that already exists. null = the business had none (and then no line may carry GST).
  sellerGstin   String?
  total         Int // subtotal − discount + gstAmount (server-computed)
  advanceAmount Int             @default(0) // 0 ≤ advance ≤ total; balance is derived, never stored
  validUntil    DateTime?
  terms         String?
  inclusions    String? // "What's included" — shown to the couple on the proposal page
  exclusions    String? // "What's not included" — shown to the couple on the proposal page
  notes         String? // internal, never shown to the customer
  pdfUrl        String? // reserved; no PDF generation in V1
  // Proposal link (docs/wedding-os/08-quotation.md §15). Only the SHA-256 of the random token is stored; the raw
  // link is shown to staff once. One link per revision; revising clears the original's hash so it can never revive.
  customerTokenHash      String?   @unique
  customerTokenCreatedAt DateTime?
  customerViewedAt       DateTime? // first time the couple opened the proposal
  changesRequestedAt     DateTime? // latest open "request changes" from the couple; never modifies the content
  changesRequestNote     String?

  sentAt          DateTime?
  acceptedAt      DateTime?
  acceptedById    String?
  acceptedBy      User?     @relation("QuotationAcceptedBy", fields: [acceptedById], references: [id])
  acceptedChannel String? // WHATSAPP | PHONE | IN_PERSON | OTHER — recorded by staff (no customer login in V1)
  acceptedNote    String?
  rejectedAt      DateTime?
  rejectionReason String?

  // Idempotency anchor for the automatic advance invoice created inside the
  // booking/lead → wedding conversion transaction (unique → at most one).
  advanceInvoiceId String?              @unique
  advanceInvoice   Invoice?             @relation("QuotationAdvanceInvoice", fields: [advanceInvoiceId], references: [id])
  invoices         Invoice[]            @relation("InvoiceQuotation") // every invoice raised against this agreement (advance, balance)
  booking          Booking? // one Booking per quotation (Booking.quotationId is unique)
  // the frozen commercial terms: one for a whole-quotation booking (no confirmation), one per confirmation otherwise (PR 8)
  agreements       CommercialAgreement[]

  items       QuotationItem[]
  createdById String?
  createdBy   User?           @relation("QuotationCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // Postgres doesn't auto-index FK columns; the source lookups are this panel's
  // hot path, and (status, validUntil) drives expiry checks.
  @@index([leadId])
  @@index([enquiryId])
  @@index([consultationId])
  @@index([status, validUntil])
  vendorEnquiries VendorEnquiry[]
  paymentSubmissions PaymentSubmission[] // "I have paid" claims from the proposal link (§18)

  // Record ownership (docs/wedding-os/15-record-ownership.md). Phase A: every row belongs to Shaadi Shopping by default; Phase B
  // removes the default and every query is scoped by the logged-in business.
  businessId String   @default("shaadi-shopping")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@index([businessId])
  @@map("quotations")
}

model QuotationItem {
  id            String    @id @default(uuid())
  quotationId   String
  quotation     Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  sortOrder     Int
  description   String // e.g. "Grand Ballroom — 500 guests"
  category      String? // Venue / Catering / Decoration …
  functionLabel String? // e.g. "Sangeet" — informational until a Wedding exists
  vendorId      String? // null = custom line; a vendor is assigned after conversion
  vendor        Vendor?   @relation(fields: [vendorId], references: [id])
  unitPrice     Int
  quantity      Int       @default(1)
  // GST on this line, typed by the vendor (6 Oct 2026; lib/quotation/lineGst.ts) — in hundredths of a percent: 18% = 1800.
  // null = no GST on this line. There is no default rate anywhere. Quotation.gstAmount is the sum of the lines' GST.
  gstRateBp     Int?
  // What this line includes, frozen when the quotation is saved — e.g. a catering menu's dishes by course (27 Oct 2026).
  // A menu changed later in "What we offer" never changes a quotation already made.
  details       String?

  @@index([quotationId])
  @@index([vendorId])
  @@map("quotation_items")
}

// docs/wedding-os/02-crm.md "AI insight storage" — a separate, versioned
// entity rather than nullable columns on Lead/Enquiry/Consultation, so
// regenerating a summary doesn't silently overwrite history and AI vs.
// human provenance stays auditable via generatedBy.
enum InsightGeneratedBy {
  AI
  HUMAN
}

model LeadInsight {
  id String @id @default(uuid())

  // Exactly one of these three is set (application-enforced), same pattern as Quotation.
  leadId         String?
  lead           Lead?         @relation(fields: [leadId], references: [id])
  enquiryId      String?
  enquiry        Enquiry?      @relation(fields: [enquiryId], references: [id])
  consultationId String?
  consultation   Consultation? @relation(fields: [consultationId], references: [id])

  generatedBy InsightGeneratedBy
  // Specific provenance (e.g. "manual", "gpt-5") — generatedBy is the coarse AI/HUMAN category.
  source      String?
  summary     String
  nextAction  String?
  sentiment   String?
  confidence  Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("lead_insights")
}

// =====================================================================
// Wedding OS (Phase B — docs/wedding-os/03-wedding-workspace.md and friends)
// Wedding is the aggregate root; see docs/wedding-os/domain-model.md §3.
// =====================================================================

enum WeddingStatus {
  PLANNING
  ACTIVE
  // Resumable, like ON_HOLD in PipelineStage — a stalled wedding needs to stay
  // visible as stalled on dashboards, not silently look identical to normal
  // progress just because a WeddingEvent.date got pushed back. Decided
  // 2026-07-22, domain-model.md §5.2.
  POSTPONED
  COMPLETED
  CANCELLED
}

// NOT a health indicator (ON_TRACK/AT_RISK/etc.) — that's computed from
// ActivityLog + child entity state at read time, per the "store events, not
// dashboard state" principle. This is the Wedding's actual lifecycle stage.
enum WeddingSource {
  CRM
  BOOKING
}

model Wedding {
  id            String        @id @default(uuid())
  weddingNumber String        @unique // human-readable reference, e.g. WED-2026-0001
  status        WeddingStatus @default(PLANNING)
  source        WeddingSource
  primaryDate   DateTime // convenience cache of the main event's date — WeddingEvent rows are the source of truth
  city          String
  guestCount    Int?
  weddingType   String?
  totalBudget   Int? // planned budget; seeded from Consultation.totalBudget or Booking.total, editable after

  // Exactly one of these four is set, matching WeddingSource — the two live
  // conversion paths resolved in domain-model.md §5. @unique enforces one
  // Wedding per source record (a Lead can't spawn two Weddings).
  sourceLeadId         String?       @unique
  sourceLead           Lead?         @relation(fields: [sourceLeadId], references: [id])
  sourceEnquiryId      String?       @unique
  sourceEnquiry        Enquiry?      @relation(fields: [sourceEnquiryId], references: [id])
  sourceConsultationId String?       @unique
  sourceConsultation   Consultation? @relation(fields: [sourceConsultationId], references: [id])
  sourceBookingId      String?       @unique
  sourceBooking        Booking?      @relation(fields: [sourceBookingId], references: [id])

  customerId    String?
  customer      User?   @relation("WeddingCustomer", fields: [customerId], references: [id])
  // The couple's mobile (10 digits, from the enquiry / booking it came from). Their OTP login is linked to this wedding by it —
  // at creation if they already have a login, else the first time they log in (lib/customer/weddingLink.ts).
  customerPhone String?
  coordinatorId String?
  coordinator   User?   @relation("WeddingCoordinator", fields: [coordinatorId], references: [id])

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  // Distinct from `updatedAt` (which any field edit touches) — needed for
  // "time from creation to completion" reporting. Found during the Step 4
  // workflow review (Wedding Completion), added directly rather than flagged
  // since it's a safe, uncontroversial addition.
  completedAt DateTime?

  couple             Couple?
  events             WeddingEvent[]
  tasks              Task[]
  activities         ActivityLog[]
  documents          Document[]
  invoices           Invoice[]
  timelineMilestones TimelineMilestone[]
  reviews            Review[]
  aiConversations    AiConversation[]
  approvals          ApprovalRequest[]   @relation("ApprovalWedding")
  guests             Guest[]
  coupleVendors      CoupleVendor[] // vendors the couple found themselves (22 Nov 2026)
  members            WeddingMember[] // family members the couple invited (23 Nov 2026)
  checklistItems     CoupleChecklistItem[] // the couple's own checklist (25 Nov 2026)
  budgetCategories   CoupleBudgetCategory[] // the couple's planned budget per category (25 Nov 2026)
  expenses           CoupleExpense[] // the couple's own expenses (25 Nov 2026)
  coupleBudget       Int? // the couple's own total budget (25 Nov 2026) — not totalBudget, which is the team's planning figure
  quoteRequests      VendorQuoteRequest[] // "Ask for a quote" from My Wedding (22 Nov 2026)

  @@index([customerPhone])
  // Record ownership (docs/wedding-os/15-record-ownership.md). Phase A: every row belongs to Shaadi Shopping by default; Phase B
  // removes the default and every query is scoped by the logged-in business.
  businessId String   @default("shaadi-shopping")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@index([businessId])
  @@map("weddings")
}

model Couple {
  id                String   @id @default(uuid())
  weddingId         String   @unique
  wedding           Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  brideName         String?
  bridePhone        String?
  groomName         String?
  groomPhone        String?
  familyContacts    Json? // flexible [{name, relation, phone}] list — a rigid sub-table is unwarranted for v1
  preferredLanguage String?
  preferences       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("couples")
}

// Whether a function stands (22 Nov 2026). Staff-made functions are CONFIRMED. A couple's function that uses the booked venue is
// WAITING until staff confirm it; NOT_POSSIBLE carries staff's reason (WeddingEvent.confirmationNote) and the couple can change it.
enum FunctionConfirmation {
  CONFIRMED
  WAITING
  NOT_POSSIBLE
}

enum WeddingEventType {
  ENGAGEMENT
  HALDI
  MEHNDI
  SANGEET
  WEDDING
  RECEPTION
  OTHER
  TILAK // 23 Nov 2026
  JANEU
  ANNIVERSARY
  GRIHA_PRAVESH // housewarming
}

model WeddingEvent {
  id           String           @id @default(uuid())
  weddingId    String
  wedding      Wedding          @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  type         WeddingEventType
  label        String? // overrides the default type label — required in practice when type=OTHER
  date         DateTime
  startTime    String? // simple "18:00"-style string — a full TZ-aware time type is unwarranted for v1
  venueName    String?
  venueAddress String?
  city         String
  budget       Int? // planned budget for THIS event; Wedding.totalBudget is the rollup, not duplicated here

  // Couple-controlled functions (22 Nov 2026, Client OS). A couple adds and edits their OWN functions from My Wedding. One that uses
  // the booked venue (atBookedVenue, or one of the venue's spaces) is WAITING until authorised staff confirm it; nothing here ever
  // changes the venue booking, a hall hold, availability or the agreed price (lib/wedding/coupleFunctions.ts).
  endTime          String? // "22:30"
  description      String?
  venueSpaceId     String? // the venue's own hall / lawn, on a venue's wedding
  venueSpace       VenueSpace?          @relation(fields: [venueSpaceId], references: [id], onDelete: SetNull)
  atBookedVenue    Boolean              @default(false)
  addedByCouple    Boolean              @default(false)
  confirmation     FunctionConfirmation @default(CONFIRMED)
  confirmationNote String? // staff's reason when it is not possible
  confirmedById    String?
  confirmedAt      DateTime?
  pendingChange    Json? // a couple's requested edit of a planner-set function; applied only when staff confirm (23 Nov 2026)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  vendorBookings VendorBooking[]
  tasks          Task[]
  approvals      ApprovalRequest[]
  guestResponses GuestFunctionResponse[]
  coupleVendors  CoupleVendor[]
  quoteRequests  VendorQuoteRequest[]
  quoteFunctions VendorQuoteFunction[]
  checklistItems CoupleChecklistItem[]

  // Production-hardening audit (2026-09-17) — every Wedding Workspace page
  // load queries this by weddingId, ordered by date; Postgres doesn't
  // auto-index FK columns. Same class already fixed for Guest/ActivityLog.
  @@index([weddingId, date])
  @@map("wedding_events")
}

enum GuestRsvpStatus {
  PENDING
  ATTENDING
  NOT_ATTENDING
  MAYBE
}

// Whose guest (Client OS guest management, 19 Nov 2026). Null = not set yet.
enum GuestSide {
  BRIDE
  GROOM
  BOTH
}

model Guest {
  id                 String          @id @default(uuid())
  weddingId          String
  wedding            Wedding         @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  name               String
  phone              String?
  email              String?
  category           String?
  accompanyingGuests Int             @default(0)
  rsvpStatus         GuestRsvpStatus @default(PENDING)
  notes              String? // shown as "Special requirements" (food, wheelchair, a room on the ground floor …)
  // Client OS guest management (19 Nov 2026), all optional so existing guests are unchanged:
  side               GuestSide? // bride side, groom side or both
  familyGroup        String? // e.g. "Sharma family" — guests with the same group are shown together
  relation           String? // e.g. "Mama", "College friend"
  isVip              Boolean         @default(false)
  // "Comes with" another guest on the same wedding (e.g. a husband and wife listed separately). One link per guest;
  // the service keeps both sides pointing at each other. Removing a guest clears the other's link.
  pairedGuestId      String?         @unique
  pairedGuest        Guest?          @relation("GuestPair", fields: [pairedGuestId], references: [id], onDelete: SetNull)
  pairedBy           Guest?          @relation("GuestPair")
  rsvpToken          String          @unique @default(uuid())
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  functionResponses GuestFunctionResponse[]

  @@index([weddingId, rsvpStatus])
  @@index([weddingId, side])
  @@map("guests")
}

model GuestFunctionResponse {
  id             String          @id @default(uuid())
  guestId        String
  guest          Guest           @relation(fields: [guestId], references: [id], onDelete: Cascade)
  weddingEventId String
  weddingEvent   WeddingEvent    @relation(fields: [weddingEventId], references: [id], onDelete: Cascade)
  status         GuestRsvpStatus @default(PENDING)
  updatedAt      DateTime        @updatedAt

  // One row per function the guest is invited to (Client OS, 19 Nov 2026). A guest with no rows at all is invited to
  // every function — how guests worked before — so nothing changes for existing guests.
  @@unique([guestId, weddingEventId])
  @@index([weddingEventId, status])
  @@map("guest_function_responses")
}

// Vendor enquiry (blueprint §43, docs/wedding-os/04-vendor-os.md §9): when staff link a vendor to a customer — on
// the consultation or on a quote line — the vendor is asked, asynchronously, whether they can take it. Never blocks
// sales; the customer never sees it. Created before any booking or wedding exists (a VendorBooking comes later).
enum VendorEnquiryStatus {
  PENDING // asked, no answer yet
  AVAILABLE
  AVAILABLE_WITH_CONDITIONS
  NOT_AVAILABLE
  ALTERNATE_DATE // vendor suggests another date
  QUOTED // vendor sent their package / quote
  WITHDRAWN // the vendor is no longer linked to this customer — nothing more is needed from them
}

model VendorEnquiry {
  id        String @id @default(uuid())
  vendorId  String
  vendor    Vendor @relation("VendorEnquiries", fields: [vendorId], references: [id], onDelete: Restrict)
  // "CONSULTATION:<id>" / "ENQUIRY:<id>" / "LEAD:<id>" — one enquiry per vendor per customer record (unique below;
  // the three nullable source columns alone could not enforce it).
  sourceKey String

  leadId         String?
  lead           Lead?         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  enquiryId      String?
  enquiry        Enquiry?      @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  consultationId String?
  consultation   Consultation? @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  quotationId    String? // the quote that last linked this vendor, if any
  quotation      Quotation?    @relation(fields: [quotationId], references: [id], onDelete: SetNull)

  // What the vendor is asked — operational facts only, never the couple's identity or the customer price.
  services   String // "Venue, Decoration"
  functions  String? // "Wedding, Reception"
  eventDate  String? // as the customer gave it
  guestCount Int?
  city       String?
  eventType  String?

  status          VendorEnquiryStatus @default(PENDING)
  responseNote    String?
  suggestedDate   String?
  quotedAmount    Int?
  responseChannel String? // VENDOR_OS, or how staff heard it: PHONE / WHATSAPP / IN_PERSON / OTHER
  respondedAt     DateTime?
  respondedById   String?
  respondedBy     User?     @relation("VendorEnquiryAnsweredBy", fields: [respondedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([vendorId, sourceKey])
  @@index([vendorId, status])
  @@index([sourceKey])
  @@map("vendor_enquiries")
}

enum VendorBookingStatus {
  PENDING_VENDOR_CONFIRMATION
  CONFIRMED
  DECLINED
  // Only used if the "coordinator proposes, customer approves" UX direction
  // from docs/wedding-os/05-customer-portal.md §3 is the one chosen — included
  // now so Step 3 doesn't need a second migration if it is.
  CUSTOMER_APPROVAL_PENDING
  CANCELLED
  COMPLETED
}

enum VenueBookingStatus {
  PENDING
  READY_FOR_SETUP
  SETUP_IN_PROGRESS
  READY
  COMPLETED
}

model VendorBooking {
  id              String              @id @default(uuid())
  weddingEventId  String
  weddingEvent    WeddingEvent        @relation(fields: [weddingEventId], references: [id], onDelete: Cascade)
  vendorId        String
  vendor          Vendor              @relation(fields: [vendorId], references: [id])
  vendorPackageId String?
  vendorPackage   VendorPackage?      @relation(fields: [vendorPackageId], references: [id])
  status          VendorBookingStatus @default(PENDING_VENDOR_CONFIRMATION)
  venueStatus     VenueBookingStatus  @default(PENDING)
  agreedPrice     Int
  declineReason   String?
  respondedAt     DateTime? // vendor's accept/decline timestamp — feeds Vendor Score's response-time component
  onTimeService   Boolean? // set post-event; feeds Vendor Score's on-time component (docs/wedding-os/04-vendor-os.md §7)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  tasks      Task[]
  activities ActivityLog[]
  documents  Document[]
  payouts    Payout[]
  vendorPayments VendorPayment[] // each payment made for this work: advance, part, final (25 Nov 2026)
  // Pricing model (money design v1, PR 4, 25 Nov 2026). null = an older assignment: commission at the category rate, as before.
  // COMMISSION: the vendor gets agreedPrice less the commission. FIXED: the vendor gets vendorPrice; agreedPrice stays the client price.
  // Set by the founder only; locked once the work order is issued (database rule, migration 20261125200000_vendor_work_orders).
  pricingModel   VendorPricingModel?
  vendorPrice    Int?
  workOrder      VendorWorkOrder?
  // Completion (money design v1, PR 6): the vendor says the work is done; staff verify it ("Mark completed" sets status COMPLETED).
  vendorDoneAt   DateTime?
  vendorDoneNote String?
  verifiedAt     DateTime?
  verifiedById   String?
  review     Review? // the couple's review of this booking (Roadmap 1.4)

  @@map("vendor_bookings")
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  DONE
  BLOCKED
}

model TimelineMilestone {
  id          String              @id @default(uuid())
  weddingId   String
  wedding     Wedding             @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  label       String // e.g. "Venue Booked" — the default 11-step sequence in 03-wedding-workspace.md §3 is a starting template, not a fixed schema
  sortOrder   Int
  ownerId     String?
  owner       User?               @relation(fields: [ownerId], references: [id])
  dueDate     DateTime?
  status      MilestoneStatus     @default(PENDING)
  // v1 supports a single upstream dependency per milestone, not a full DAG —
  // sufficient for a linear-with-occasional-branches timeline, revisit if a
  // real wedding needs more complex dependency graphs than this expresses.
  dependsOnId String?
  dependsOn   TimelineMilestone?  @relation("MilestoneDependency", fields: [dependsOnId], references: [id])
  dependents  TimelineMilestone[] @relation("MilestoneDependency")
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  // Production-hardening audit (2026-09-17) — every Wedding Workspace page
  // load queries this by weddingId, ordered by sortOrder; Postgres doesn't
  // auto-index FK columns.
  @@index([weddingId, sortOrder])
  @@map("timeline_milestones")
}

enum DocumentCategory {
  CONTRACT
  QUOTATION
  INVOICE
  ID_PROOF
  VENUE_AGREEMENT
  FLOOR_PLAN
  MENU
  RECEIPT
  OTHER
}

enum DocumentVisibility {
  INTERNAL
  CUSTOMER_VISIBLE
}

model Document {
  id              String             @id @default(uuid())
  weddingId       String
  wedding         Wedding            @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  vendorBookingId String? // set for vendor-specific docs (quotations/receipts tied to one VendorBooking)
  vendorBooking   VendorBooking?     @relation(fields: [vendorBookingId], references: [id])
  category        DocumentCategory
  // Default INTERNAL is deliberate — a document must be explicitly marked
  // customer-visible, not accidentally exposed by omission. See
  // docs/wedding-os/05-customer-portal.md §3's Documents section.
  visibility      DocumentVisibility @default(INTERNAL)
  fileName        String
  url             String // Cloudinary URL — same upload pattern as every other image/file in this app, no new storage system
  uploadedById    String?
  uploadedBy      User?              @relation(fields: [uploadedById], references: [id])
  createdAt       DateTime           @default(now())

  // Production-hardening audit (2026-09-17) — every Wedding Workspace page
  // load queries this by weddingId, ordered by createdAt; Postgres doesn't
  // auto-index FK columns.
  @@index([weddingId, createdAt])
  @@map("documents")
}

// =====================================================================
// Shared / cross-context entities (docs/wedding-os/domain-model.md §1)
// Referenced by both CRM and Wedding contexts by design — unifying these
// avoids two near-identical, drifting systems (one per context).
// =====================================================================

enum TaskContext {
  SALES_FOLLOWUP
  WEDDING_TASK
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Task {
  id          String       @id @default(uuid())
  context     TaskContext
  title       String
  description String?
  status      TaskStatus   @default(PENDING)
  priority    TaskPriority @default(MEDIUM)
  dueAt       DateTime?
  completedAt DateTime?

  assignedToId String?
  assignedTo   User?   @relation("TaskAssignedTo", fields: [assignedToId], references: [id])
  createdById  String?
  createdBy    User?   @relation("TaskCreatedBy", fields: [createdById], references: [id])

  // Exactly one subject is set, matching `context` — SALES_FOLLOWUP tasks
  // reference one of lead/enquiry/consultation, WEDDING_TASK tasks reference
  // wedding (and optionally a specific event/vendorBooking within it).
  leadId          String?
  lead            Lead?          @relation(fields: [leadId], references: [id])
  enquiryId       String?
  enquiry         Enquiry?       @relation(fields: [enquiryId], references: [id])
  consultationId  String?
  consultation    Consultation?  @relation(fields: [consultationId], references: [id])
  weddingId       String?
  wedding         Wedding?       @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  weddingEventId  String?
  weddingEvent    WeddingEvent?  @relation(fields: [weddingEventId], references: [id])
  vendorBookingId String?
  vendorBooking   VendorBooking? @relation(fields: [vendorBookingId], references: [id])

  // Per docs/wedding-os/07-ai-assistant.md — AI can suggest (Level 2) but not
  // create unilaterally in v1; a suggested Task should go through
  // ApprovalRequest before this flag is trusted as "a human signed off."
  aiSuggested Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Production-hardening audit (2026-09-17) — every Wedding Workspace page
  // load queries this by weddingId, ordered by createdAt; Postgres doesn't
  // auto-index FK columns. Task's other subject FKs (leadId/enquiryId/
  // consultationId/weddingEventId/vendorBookingId) are a separate, lower-
  // traffic finding from the same audit — not addressed here.
  @@index([weddingId, createdAt])
  @@map("tasks")
}

enum ActivityType {
  CALL
  WHATSAPP
  EMAIL
  MEETING
  NOTE // "Notes" from early sketches — modeled as an entry type here, not a 4th table (domain-model.md §4)
  // System-generated event types — this list is what fulfills "store events,
  // not state" in practice. Extend this enum, don't add parallel status columns.
  STATUS_CHANGED
  VENDOR_CONFIRMED
  VENDOR_DECLINED
  PAYMENT_RECEIVED
  TASK_CREATED
  TASK_COMPLETED
  TASK_OVERDUE
  TIMELINE_DELAYED
  DOCUMENT_UPLOADED
  AI_DRAFT_CREATED
  ASSIGNED // Sprint 5.3 — lead/enquiry/consultation reassignment
  APPROVAL_REQUESTED
  APPROVAL_APPROVED
  APPROVAL_CHANGES_REQUESTED
  APPROVAL_CANCELLED
  // Quotation workflow (08-quotation.md)
  QUOTATION_SENT
  QUOTATION_ACCEPTED
  QUOTATION_REJECTED
  QUOTATION_REVISED
  INVOICE_CREATED
  QUOTATION_CHANGES_REQUESTED // the couple asked for changes on the proposal page
  PROPOSAL_VIEWED // the couple opened the proposal link for the first time
  VENDOR_ENQUIRY_SENT // a vendor linked to this customer was asked for availability (04-vendor-os.md §9)
  VENDOR_ENQUIRY_ANSWERED // the vendor answered (in Vendor OS, or recorded by staff)
  PAYMENT_SUBMITTED // the couple said they paid (UPI) on the proposal link — staff verify it (08-quotation.md §18)
  PAYMENT_SUBMISSION_REJECTED // staff could not match a payment the couple submitted
  REVIEW_SUBMITTED // the couple reviewed a vendor from the proposal link (Roadmap 1.4) — staff publish or hide it
}

model ActivityLog {
  id      String       @id @default(uuid())
  type    ActivityType
  summary String // short human-readable line, e.g. "Vendor confirmed for Sangeet"
  detail  String? // longer note/body — call notes, AI draft content, etc.

  // Per docs/wedding-os/07-ai-assistant.md §3's guardrail: every AI-drafted
  // entry must be flagged as such, and if it was externally sent, who approved it.
  aiGenerated   Boolean @default(false)
  approvedById  String?
  approvedBy    User?   @relation("ActivityApprovedBy", fields: [approvedById], references: [id])
  performedById String?
  performedBy   User?   @relation("ActivityPerformedBy", fields: [performedById], references: [id])

  // Sprint 5.4 — structured mirror of a STATUS_CHANGED entry's stage
  // transition, populated only by leadWorkspace.service.ts's transitionStage().
  // `summary` stays the human-readable line; Pipeline Velocity and similar
  // analytics read these instead of parsing display text.
  fromStage PipelineStage?
  toStage   PipelineStage?

  // Same "exactly one subject" pattern as Task — spans pre- and
  // post-conversion so a coordinator never needs a separate CRM log.
  leadId          String?
  lead            Lead?          @relation(fields: [leadId], references: [id])
  enquiryId       String?
  enquiry         Enquiry?       @relation(fields: [enquiryId], references: [id])
  consultationId  String?
  consultation    Consultation?  @relation(fields: [consultationId], references: [id])
  weddingId       String?
  wedding         Wedding?       @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  vendorBookingId String?
  vendorBooking   VendorBooking? @relation(fields: [vendorBookingId], references: [id])

  // Deliberately no `updatedAt` — append-only/immutable by convention, the
  // event trail this system's Health Score and AI summaries derive from.
  createdAt DateTime @default(now())

  @@index([weddingId, createdAt])
  @@map("activity_logs")
}

enum ApprovalSubjectType {
  SERVICE_SELECTION
  DECORATION
  MENU
  DESIGN
  QUOTATION
  OTHER
  VENDOR_PROFILE_CHANGE
  AI_DRAFT
  CUSTOMER_VENDOR_APPROVAL
}

enum ApprovalStatus {
  DRAFT
  PENDING_CLIENT
  PENDING
  APPROVED
  CHANGES_REQUESTED
  CANCELLED
  REJECTED
}

// Unifies three previously-separate-sounding approval flows named across
// 04-vendor-os.md, 05-customer-portal.md, and 07-ai-assistant.md — one entity,
// three subject types, instead of three near-identical tables that would
// drift from each other over time. `subjectId` is resolved at the application
// layer based on `subjectType` (no DB-level polymorphic FK in Postgres).
model ApprovalRequest {
  id             String              @id @default(uuid())
  subjectType    ApprovalSubjectType
  subjectId      String
  title          String?
  description    String?
  amount         Int?
  deadline       DateTime?
  weddingId      String?
  wedding        Wedding?            @relation("ApprovalWedding", fields: [weddingId], references: [id], onDelete: Cascade)
  weddingEventId String?
  weddingEvent   WeddingEvent?       @relation(fields: [weddingEventId], references: [id], onDelete: SetNull)
  requestedById  String?
  requestedBy    User?               @relation("ApprovalRequestedBy", fields: [requestedById], references: [id])
  status         ApprovalStatus      @default(PENDING)
  approvedById   String?
  approvedBy     User?               @relation("ApprovalApprovedBy", fields: [approvedById], references: [id])
  approvedAt     DateTime?
  notes          String?
  clientComment  String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  // Resolves drift that's been silently re-excluded from three prior migrations (add_vendor_capability,
  // add_vendor_prospect, add_vendor_area) — these two indexes were created live by migration
  // 20260825000000_add_client_approvals but never declared here, so every unrelated schema change since
  // has had Prisma propose dropping them. Declaring them for real instead of excluding a fourth time.
  @@index([weddingId])
  @@index([weddingEventId])
  @@map("approval_requests")
}

// =====================================================================
// Finance (Phase B — docs/wedding-os/06-finance.md)
// Deliberately does NOT encode GST/tax treatment — only the data shape
// needed to support whatever structure a CA confirms. See the doc for why.
// =====================================================================

enum PaymentStatus {
  SUCCESS
  FAILED
  REFUNDED
}

model Payment {
  id                String        @id @default(uuid())
  invoiceId         String
  invoice           Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount            Int
  // Razorpay's method string (upi/card/netbanking/wallet/...) — kept as plain
  // text rather than a rigid enum since Razorpay's own method list can change
  // independent of this schema.
  method            String
  razorpayPaymentId String?       @unique
  razorpayOrderId   String?
  status            PaymentStatus @default(SUCCESS)
  paidAt            DateTime      @default(now())
  createdAt         DateTime      @default(now())

  // Money v1: who recorded a payment received outside Razorpay, and its bank / UPI reference (UTR). `receiptId` groups the rows one
  // receipt was split into (a payment larger than the advance invoice is applied to the balance invoice too); `idempotencyKey`
  // (unique) makes a double-submitted form a no-op.
  reference      String?
  recordedById   String?
  recordedBy     User?   @relation("PaymentRecordedBy", fields: [recordedById], references: [id])
  receiptId      String?
  idempotencyKey String? @unique

  @@index([receiptId])
  // Record ownership (docs/wedding-os/15-record-ownership.md). Phase A: every row belongs to Shaadi Shopping by default; Phase B
  // removes the default and every query is scoped by the logged-in business.
  businessId String   @default("shaadi-shopping")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@index([businessId])
  @@map("payments")
}

enum PaymentSubmissionStatus {
  PENDING // the couple says they paid; nothing is counted yet
  VERIFIED // staff matched it — a Payment was recorded through the normal Money v1 path (receiptId below)
  REJECTED // staff could not match it (rejectReason is shown to the couple)
}

// Roadmap 1.3 (08-quotation.md §18) — "I have paid" from the couple's proposal link. A CLAIM, never money: received / Date Held /
// Confirmed still come only from Payment rows. Verifying records the Payment through recordPaymentForQuotation (UTR as its reference,
// "sub-<id>" as its idempotency key), so the 25% rule, the hold and auto-confirmation are unchanged.
model PaymentSubmission {
  id          String    @id @default(uuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  amount      Int
  method      String    @default("UPI")
  utr         String // the bank / UPI transaction reference, as the couple gave it (spaces removed)
  paidOn      DateTime? // when the couple says the money moved
  note        String?

  // Private Cloudinary asset (type "private") — never a public URL; staff get a short-lived signed link.
  proofPublicId String?
  proofFormat   String?

  status       PaymentSubmissionStatus @default(PENDING)
  rejectReason String?
  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   User?                   @relation("PaymentSubmissionReviewedBy", fields: [reviewedById], references: [id])
  receiptId    String? // the receipt of the Payment recorded on verification
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@index([quotationId, status])
  @@index([status, createdAt])
  @@map("payment_submissions")
}

enum PaymentLinkStatus {
  CREATED
  PAID
  EXPIRED
  CANCELLED
}

// Sprint 7.2 — tracks a sent-but-not-yet-paid Razorpay Payment Link so admins
// can see "link sent, awaiting payment" without a fake/nullable Payment row.
// Payment stays "money that actually moved" (Sprint 7.1's rule); this is the
// pending-state table that rule implies is needed alongside it.
// Money v1 (docs/wedding-os/10-commercial-flow-v1.md, 22 Sep 2026). The commercial terms an accepted quotation was booked on, frozen
// when the booking is made: the total, the confirmation rule it was made under (percent, rounding, hold window) and the exact amount
// that rule required, what was accepted (items with their quotation-item ids, function labels, terms) and by whom. It is the
// booking-time protection — a later change to a venue's default terms, a vendor price, or the business rules never re-prices a deal.
//
// It stores NO money that moves: what was received is always summed from Payment rows, and "Date Held" / "Confirmed" are derived
// from that (lib/commercial/rules.ts). The only operational timestamps kept are the hold window's start/end (set once, by the first
// payment) and the moment the booking was confirmed. One per accepted quotation; the booking is optional because a CRM lead whose
// quotation was accepted has no Booking.
model CommercialAgreement {
  id                   String    @id @default(uuid())
  // One agreement per quotation for an agreement with no confirmation (whole-quotation bookings, every agreement made before
  // 25 Nov 2026); one per confirmation otherwise. Both are database rules (partial unique indexes, migration 20261126000000).
  quotationId          String
  confirmationId       String?       @unique
  confirmation         Confirmation? @relation(fields: [confirmationId], references: [id], onDelete: Restrict)
  quotation            Quotation @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  quotationRevision    Int
  bookingId            String?   @unique
  booking              Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  customerId           String?
  customerName         String
  customerPhone        String
  currency             String    @default("INR")
  subtotal             Int
  discountAmount       Int
  taxAmount            Int
  agreementTotal       Int
  confirmationPercent  Int
  confirmationAmount   Int
  confirmationRounding String
  holdWindowDays       Int
  termsSnapshot        String?
  itemsSnapshot        Json
  functionLabels       Json
  acceptedAt           DateTime?
  acceptedById         String?
  holdStartedAt        DateTime?
  holdExpiresAt        DateTime?
  confirmedAt          DateTime?
  createdAt            DateTime  @default(now())

  // Payment schedule (22 Nov 2026): the balance after the booking amount, split into dated instalments by staff. Saved as a whole;
  // scheduleVersion goes up on every save so an edit made on an out-of-date screen is refused instead of overwriting a newer one.
  scheduleVersion      Int       @default(0)
  instalments          PaymentInstalment[]

  // Record ownership (docs/wedding-os/15-record-ownership.md). Phase A: every row belongs to Shaadi Shopping by default; Phase B
  // removes the default and every query is scoped by the logged-in business.
  businessId String   @default("shaadi-shopping")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@index([businessId])
  @@index([quotationId])
  @@map("commercial_agreements")
}

// One dated instalment of an agreement's balance (22 Nov 2026). The booking amount (CommercialAgreement.confirmationAmount) is not an
// instalment — it is fixed by the agreement. Together the instalments always add up to exactly agreementTotal − confirmationAmount
// (checked on every save, services/paymentSchedule.service.ts). Payments are matched to instalments in date order when shown;
// nothing is stored per instalment about payments. Belongs to its business through the agreement (a child record).
model PaymentInstalment {
  id          String              @id @default(uuid())
  agreementId String
  agreement   CommercialAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  sortOrder   Int
  label       String
  amount      Int
  dueDate     DateTime            @db.Date
  createdById String?
  createdAt   DateTime            @default(now())

  @@unique([agreementId, sortOrder])
  @@map("payment_instalments")
}

model PaymentLink {
  id                    String            @id @default(uuid())
  invoiceId             String
  invoice               Invoice           @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  razorpayPaymentLinkId String            @unique
  shortUrl              String
  amount                Int
  status                PaymentLinkStatus @default(CREATED)
  expiresAt             DateTime?
  createdById           String?
  createdBy             User?             @relation(fields: [createdById], references: [id])
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@map("payment_links")
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

model Payout {
  id               String        @id @default(uuid())
  vendorBookingId  String
  vendorBooking    VendorBooking @relation(fields: [vendorBookingId], references: [id])
  vendorId         String
  vendor           Vendor        @relation(fields: [vendorId], references: [id])
  grossAmount      Int // VendorBooking.agreedPrice at time of payout
  // Rate is a snapshot at payout time, not a live reference to CommissionRate —
  // so a later rate-config change never silently rewrites historical payouts.
  commissionRate   Float
  commissionAmount Int
  netAmount        Int
  status           PayoutStatus  @default(PENDING)
  payoutBatchId    String?
  payoutBatch      PayoutBatch?  @relation(fields: [payoutBatchId], references: [id])
  paidAt           DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  // Sprint 7.3 — one payout per booking; app-level eligibility checks in
  // payout.service.ts are backed by this DB-level constraint against a race.
  @@unique([vendorBookingId])
  @@map("payouts")
}

// Only meaningful if payouts end up cyclical/batched rather than per-booking —
// docs/wedding-os/06-finance.md flags payout timing as still an open business
// decision. Included now so Step 3 doesn't need a second migration either way.
model PayoutBatch {
  id          String    @id @default(uuid())
  status      String    @default("PENDING")
  totalAmount Int
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  payouts Payout[]

  @@map("payout_batches")
}

// null categoryId = the global default rate. Only needed if commission varies
// by category — docs/wedding-os/06-finance.md §4 flags this as undecided;
// modeled now so both a flat and a per-category rate are representable.
model CommissionRate {
  id            String    @id @default(uuid())
  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id])
  rate          Float // percentage, e.g. 10.0 = 10%
  effectiveFrom DateTime  @default(now())
  createdAt     DateTime  @default(now())

  @@map("commission_rates")
}

// Route A (marketplace/commission) commercial relationship — which partner tier a vendor is
// on. Versioned the same way CommissionRate is above: a tier change is a NEW row with a later
// effectiveFrom, never an edit to an existing one. "Currently effective" is resolved at query
// time (most recent row with effectiveFrom <= now, same shape as
// commissionRateRepository.findCurrentRate), not a stored boolean — so there's no
// isCurrent/isActive flag to keep in sync. Deliberately has NO relation to CommissionRate yet —
// whether/how tier feeds commission resolution is a separate, explicitly undecided question
// (see the 2026-09-23 business-model architecture audit); this model only establishes which
// tier a vendor is on and its history, nothing downstream reads it yet.
enum PartnerTier {
  PARTNER
  GROWTH_PARTNER
  PREMIUM_PARTNER
}

model PartnerAgreement {
  id            String      @id @default(uuid())
  vendorId      String
  vendor        Vendor      @relation(fields: [vendorId], references: [id])
  tier          PartnerTier
  effectiveFrom DateTime    @default(now())
  createdAt     DateTime    @default(now())

  @@map("partner_agreements")
}

// =====================================================================
// Vendor OS (Phase B — docs/wedding-os/04-vendor-os.md)
// =====================================================================

enum AvailabilityStatus {
  AVAILABLE
  TENTATIVE
  BOOKED
  BLOCKED
}

model VendorAvailability {
  id        String             @id @default(uuid())
  vendorId  String
  vendor    Vendor             @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  date      DateTime           @db.Date
  status    AvailabilityStatus @default(AVAILABLE)
  note      String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([vendorId, date])
  @@map("vendor_availability")
}

enum ReviewStatus {
  PENDING // sent by the couple; not public until staff publish it
  PUBLISHED // shown on the vendor's public page
  HIDDEN // staff decided not to show it (kept, never deleted)
}

// Roadmap 1.4 (08-quotation.md §19) — a couple's review of a vendor they actually booked: one per CONFIRMED/COMPLETED vendor
// booking on a COMPLETED wedding, sent from the proposal link, public only after staff publish it. Kept apart from
// Vendor.rating / reviewCount (hand-entered "online rating"), which are never blended with these.
model Review {
  id              String         @id @default(uuid())
  vendorId        String
  vendor          Vendor         @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  weddingId       String?
  wedding         Wedding?       @relation(fields: [weddingId], references: [id])
  vendorBookingId String?        @unique // the booking it is tied to — at most one review per booking
  vendorBooking   VendorBooking? @relation(fields: [vendorBookingId], references: [id], onDelete: SetNull)
  authorName      String // the name the couple chose to show
  rating          Int // 1-5
  comment         String?
  status          ReviewStatus   @default(PENDING)
  moderatedAt     DateTime?
  moderatedById   String?
  moderatedBy     User?          @relation("ReviewModeratedBy", fields: [moderatedById], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @default(now()) @updatedAt

  @@index([vendorId, status])
  @@index([weddingId])
  @@map("reviews")
}

// Isolated from Vendor deliberately — sensitive/regulated data (bank/UPI
// details) benefits from its own table with stricter access control, not just
// a flag on the main Vendor record. Application layer must encrypt at rest;
// Prisma does not do this automatically. See docs/wedding-os/06-finance.md §3.
model VendorPaymentDetails {
  id                String   @id @default(uuid())
  vendorId          String   @unique
  vendor            Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  accountHolderName String?
  // SECURITY: deliberately unused today — confirmed 2026-09-01 that no
  // repository, service, API route, or admin/vendor-portal UI anywhere
  // reads or writes this model (payouts are calculation + manual
  // PENDING->PAID tracking only, see payout.service.ts; payout timing/
  // disbursement is still an open decision, docs/wedding-os/06-finance.md
  // §"open questions"). DO NOT wire bankAccountNumber into any code path
  // without column-level encryption at rest first.
  bankAccountNumber String?
  ifscCode          String?
  upiId             String?
  gstin             String? // docs/wedding-os/06-finance.md §5 — pending CA confirmation of actual usage
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("vendor_payment_details")
}

// =====================================================================
// AI (Phase B — docs/wedding-os/07-ai-assistant.md)
// v1 scope is Level 1 (Assistant) + Level 2 (Copilot) only — this table logs
// every AI interaction regardless of level, for the same audit-trail reason
// ActivityLog.aiGenerated exists.
// =====================================================================

enum AiConversationChannel {
  CUSTOMER_QA
  SALES_DRAFT
  VENDOR_DRAFT
  SUMMARY
}

model AiConversation {
  id        String                @id @default(uuid())
  channel   AiConversationChannel
  weddingId String?
  wedding   Wedding?              @relation(fields: [weddingId], references: [id])
  userId    String?
  user      User?                 @relation(fields: [userId], references: [id])
  prompt    String
  response  String
  createdAt DateTime              @default(now())

  @@map("ai_conversations")
}

// =====================================================================
// Notifications — surfaced in this pass because 04/05/07 all named
// "reminder"/"alert"/"notify" behaviors without a delivery mechanism behind
// them. Distinct from ActivityLog: ActivityLog records what happened,
// Notification is about alerting a specific user about it.
// =====================================================================

enum NotificationChannel {
  IN_APP
  WHATSAPP
  EMAIL
  PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  READ
  FAILED
}

model Notification {
  id        String              @id @default(uuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id])
  channel   NotificationChannel
  title     String
  body      String
  status    NotificationStatus  @default(PENDING)
  readAt    DateTime?
  sentAt    DateTime?
  // Loose reference, not a hard FK — a notification can be about many kinds of
  // subject (wedding, task, payment reminder); resolved at the application layer.
  weddingId String?
  taskId    String?
  createdAt DateTime            @default(now())

  @@map("notifications")
}

// ---- Growth Partner Program (docs/wedding-os/14-growth-partner.md) -----------------------------------------------
// People with wedding-industry contacts register as Growth Partners and refer venues, vendors, clients or events.
// V1 is operationally simple: staff verify every partner and referral by hand, and enter any payout themselves.

enum GrowthPartnerStatus {
  NEW
  UNDER_REVIEW
  APPROVED
  REJECTED
  INACTIVE
}

enum PartnerReferralType {
  VENUE
  VENDOR
  CLIENT
  EVENT
}

enum PartnerReferralStatus {
  SUBMITTED
  VERIFIED
  CONTACTED
  IN_DISCUSSION
  CONVERTED
  COMPLETED
  PAID
  REJECTED
}

enum PartnerPayoutStatus {
  NOT_DUE
  DUE
  PAID
}

model GrowthPartner {
  id            String              @id @default(uuid())
  code          String              @unique // "GP-1001" — shown once on registration; with the mobile it identifies the partner on referrals
  name          String
  phone         String              @unique // 10-digit Indian mobile
  whatsapp      String?
  email         String?
  city          String
  category      String // "Event Planner / Coordinator", … (what best describes them)
  referralTypes String[] // venues / vendors / clients / events / multiple
  networkNote   String?
  consentAt     DateTime // agreed to be contacted about the program
  status        GrowthPartnerStatus @default(NEW)
  staffNotes    String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  referrals PartnerReferral[]

  @@index([status])
  @@index([city])
  @@map("growth_partners")
}

model PartnerReferral {
  id            String                @id @default(uuid())
  partnerId     String
  partner       GrowthPartner         @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  type          PartnerReferralType
  name          String // person or business name
  phone         String
  city          String
  requirement   String?
  notes         String? // from the partner
  consentAt     DateTime // the partner confirmed the referral agreed to be contacted
  status        PartnerReferralStatus @default(SUBMITTED)
  assignedToId  String?
  assignedTo    User?                 @relation("PartnerReferralAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  completedAt   DateTime?
  payoutStatus  PartnerPayoutStatus   @default(NOT_DUE)
  payoutAmount  Int? // rupees, entered by staff — no automatic rates in V1
  paidAt        DateTime?
  staffNotes    String?
  // Where the referral went (MASTER-GAP-ANALYSIS §2.4): a couple becomes a CRM consultation, a venue/vendor a vendor prospect.
  consultationId   String?         @unique
  consultation     Consultation?   @relation(fields: [consultationId], references: [id], onDelete: SetNull)
  vendorProspectId String?         @unique
  vendorProspect   VendorProspect? @relation(fields: [vendorProspectId], references: [id], onDelete: SetNull)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([partnerId])
  @@index([status])
  @@index([type])
  @@map("partner_referrals")
}

// ---------- Record ownership (docs/wedding-os/15-record-ownership.md, approved 4 Oct 2026) ----------

enum BusinessKind {
  PLATFORM // Shaadi Shopping itself — exactly one, id "shaadi-shopping"
  VENDOR // a venue or vendor running its own business in Vivah OS
}

// Blueprint §13: the vendor's commercial relationship, as structured data. Null for the platform.
enum CommercialStatus {
  COMMISSION_PARTNER
  SAAS
  BOTH
  MARKETPLACE_ONLY
  INACTIVE
}

enum BusinessRole {
  OWNER // everything, including money, staff and settings
  STAFF // enquiries, quotations, weddings — not settings or payouts (the role before MANAGER / EMPLOYEE existed)
  MANAGER // the day-to-day work — no money unless the owner allows it for that person
  EMPLOYEE // their own assigned work, plus whatever the owner allows
}

// Every customer record belongs to exactly one Business (D1). A venue's own records are private to it (D3).
model Business {
  id               String            @id @default(uuid())
  name             String
  kind             BusinessKind
  commercialStatus CommercialStatus?
  vendorId         String?           @unique // its public listing, if it has one
  vendor           Vendor?           @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  numberPrefix     String?           @unique // per-business document numbers (D6); null = the platform's QTN- / INV- / WED-
  upiId            String? // where its customers pay (D7); the platform still uses SHAADI_UPI_ID until Phase D
  upiName          String?
  // The business's own commercial rule for ITS customers (venues set their own; approved 4 Oct 2026). Null = the platform rule
  // (lib/commercial/rules.ts: 25% confirms, 7-day hold). Frozen into each agreement when it is made, like the platform rule.
  confirmationPercent Int?
  holdWindowDays      Int?
  // The number its customers see on their proposal link (D8). Null = the platform's / the vendor listing's.
  contactPhone        String?
  // The business profile a vendor completes on first sign-in (6 Oct 2026; lib/venue/profile.ts) — the letterhead of its documents.
  // logoUrl / videoUrl are our own uploads only (or, for the video, a YouTube / Instagram link). gstin is optional; it becomes
  // mandatory only where a document charges GST. videoStatus: PENDING until Shaadi Shopping approves the video for the PUBLIC
  // listing (null = no video) — the business's own documents use it straight away.
  logoUrl             String?
  gstin               String?
  videoUrl            String?
  videoStatus         BusinessPhotoStatus?
  // The address of its own public enquiry page, /enquire/<enquirySlug> (11 Nov 2026, Vivah OS phase 1). Made from the name the first
  // time the team opens it; null until then.
  enquirySlug         String?           @unique
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  members               BusinessMember[]
  photos                BusinessPhoto[]
  leads                 Lead[]
  enquiries             Enquiry[]
  consultations         Consultation[]
  clients               BusinessClient[]
  offerings             BusinessOffering[]
  spaces                VenueSpace[]
  slots                 VenueSlot[]
  quotations            Quotation[]
  bookings              Booking[]
  commercialAgreements  CommercialAgreement[]
  confirmations         Confirmation[]
  weddings              Wedding[]
  invoices              Invoice[]
  payments              Payment[]

  @@map("businesses")
}

// What a venue offers for each wedding function (Haldi: lawn, decoration, veg plate …), with its starting price — its own price list
// for the customers it brings itself. Offered as one-tap lines in the venue's quotation form, and shown to the couple when they ask
// to add a function on their proposal link. Not an owned record: always read and written by the business of the current scope.
// A photo a business uploaded to its profile (6 Oct 2026). Usable at once on the business's own quotations and proposal links;
// shown on its PUBLIC Shaadi Shopping listing only after an admin approves it (status APPROVED → copied to Vendor.images).
// Like BusinessOffering, not an owned table: services/venueProfile.service.ts names the business on every read and write.
enum BusinessPhotoStatus {
  PENDING
  APPROVED
  REJECTED
}

model BusinessPhoto {
  id         String              @id @default(uuid())
  businessId String
  business   Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  url        String // our own Cloudinary upload, never an address from a request
  status     BusinessPhotoStatus @default(PENDING)
  reviewedAt DateTime?
  createdAt  DateTime            @default(now())

  @@index([businessId, createdAt])
  @@index([status, createdAt])
  @@map("business_photos")
}

// The kinds a business's price list is sorted by (7 Oct 2026; lib/venue/offering.ts). OTHER = not sorted yet.
enum OfferingKind {
  RENTAL
  CATERING
  DECORATION
  SERVICE
  PACKAGE
  OTHER
}

// The business's ONE price list — "What we offer" (the catalog). An item has a kind, may be for one wedding function (null = any),
// and may be hidden (active = false: kept, but not offered on quotations or to couples). sourcePackageId: copied from that
// package on the business's public Shaadi Shopping page — the copy is the business's own from then on.
model BusinessOffering {
  id              String            @id @default(uuid())
  businessId      String
  business        Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  kind            OfferingKind      @default(OTHER)
  function        WeddingEventType?
  name            String
  description     String?
  price           Int // whole rupees
  perPlate        Boolean           @default(false)
  active          Boolean           @default(true)
  // Catering menus (Phase 4, 27 Oct 2026; lib/venue/menu.ts) — only for kind CATERING. diet: VEG | NON_VEG | JAIN | MIXED.
  // menu: { dishes: [{ course, name }], extras: [{ name, price, perPlate }] } — the extras are the ONLY additions a quotation
  // can make to this menu (founder: fixed menus + controlled customisation).
  diet            String?
  menu            Json?
  sourcePackageId String?
  sourcePackage   VendorPackage?    @relation(fields: [sourcePackageId], references: [id], onDelete: SetNull)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([businessId, function])
  @@index([businessId, kind])
  @@map("business_offerings")
}

// A login working in a business (D2: venues can have several). Nothing reads this until Phase B.
model BusinessMember {
  id         String       @id @default(uuid())
  businessId String
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       BusinessRole
  // 7 Oct 2026 — Person → Membership → Role → Permissions (lib/auth/permissions.ts). What this person may do in this business is
  // the role's defaults, plus `grants`, minus `denies` (permission names). removedAt: no longer in the team — kept so that
  // what they did still names them.
  jobTitle   String?
  grants     String[]     @default([])
  denies     String[]     @default([])
  removedAt  DateTime?
  createdAt  DateTime     @default(now())

  @@unique([businessId, userId])
  @@index([userId])
  @@map("business_members")
}

// Halls and shifts (17 Nov 2026, founder: before launch). A venue's own halls and lawns, and the hall + date + shift each of its
// enquiries reserves, or that it blocks by hand. Not owned tables (like BusinessOffering): every read and write names the business
// of the current scope itself (services/venueSpace.service.ts). lib/venue/slots.ts has the rules: FULL_DAY takes both DAY and NIGHT.
enum VenueShift {
  DAY
  NIGHT
  FULL_DAY
}

model VenueSpace {
  id         String      @id @default(uuid())
  businessId String
  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String // "Royal Hall", "Garden Lawn"
  capacity   Int? // guests, optional, shown beside the name
  sortOrder  Int         @default(0)
  active     Boolean     @default(true) // false = kept (its slots still show) but not offered for new ones
  slots      VenueSlot[]
  functions  WeddingEvent[] // couple / staff functions placed in this space (22 Nov 2026)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([businessId, name])
  @@map("venue_spaces")
}

// One hall on one date for one shift. consultationId set = reserved by that enquiry: booked once its booking is confirmed,
// "accepted" while the booking waits, only "quoted" before that. consultationId null = blocked by hand (note says why).
model VenueSlot {
  id             String        @id @default(uuid())
  businessId     String
  business       Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  spaceId        String
  space          VenueSpace    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  date           DateTime      @db.Date
  shift          VenueShift
  consultationId String?
  consultation   Consultation? @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  note           String?
  // A temporary hold (17 Nov 2026): while holdUntil is in the future this enquiry's slot TAKES the hall, before anything is accepted.
  // It ends by itself — nothing has to run: once the time passes the slot reads as quoted again (lib/venue/slots.ts).
  holdUntil      DateTime?
  heldById       String?
  createdById    String?
  createdAt      DateTime      @default(now())

  // One enquiry holds a hall + date + shift once (a double tap saves one row). Hand blocks (no enquiry) are not covered: Postgres
  // treats NULLs as distinct; the screen disables the button while saving.
  @@unique([spaceId, date, shift, consultationId])
  @@index([businessId, date])
  @@index([consultationId])
  @@map("venue_slots")
}

// A vendor the couple found and hired themselves (22 Nov 2026, Client OS → Vendors). Kept apart from VendorBooking on purpose: it is
// NOT a Shaadi Shopping partner, carries no commission, is never verified by us and never becomes a payout. The couple adds, edits and
// removes it; staff can see it so the day can be coordinated. Belongs to its business through the wedding (a child record).
model CoupleVendor {
  id             String        @id @default(uuid())
  weddingId      String
  wedding        Wedding       @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  weddingEventId String? // the function it is for (optional)
  weddingEvent   WeddingEvent? @relation(fields: [weddingEventId], references: [id], onDelete: SetNull)
  name           String
  category       String // "Photographer", "Mehndi artist" …
  phone          String?
  price          Int? // what the couple agreed with them — their own record, not ours
  notes          String?
  createdById    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([weddingId])
  @@map("couple_vendors")
}

enum QuoteRequestStatus {
  REQUESTED // the couple asked; Shaadi Shopping has not answered yet
  QUOTED // Shaadi Shopping shared a price with the couple
  NOT_AVAILABLE // the vendor cannot do it (staff note says why)
  BOOKED // it became a vendor booking on the wedding
  CLOSED // the couple or staff closed it
}

// "Ask for a quote" (22 Nov 2026): the couple asks Shaadi Shopping for a listed vendor's price for their wedding. Shaadi Shopping
// coordinates it (checks the vendor, shares the price, books it as a VendorBooking — commission applies there, as for any partner).
// One request per vendor per wedding: asking again shows the same request. Belongs to its business through the wedding.
model VendorQuoteRequest {
  id             String             @id @default(uuid())
  weddingId      String
  wedding        Wedding            @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  vendorId       String
  vendor         Vendor             @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  weddingEventId String?
  weddingEvent   WeddingEvent?      @relation(fields: [weddingEventId], references: [id], onDelete: SetNull)
  note           String? // from the couple
  status         QuoteRequestStatus @default(REQUESTED)
  staffNote      String? // what the couple reads back (the price, or why not)
  requestedById  String?
  handledById    String?
  handledAt      DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  functions      VendorQuoteFunction[] // the functions this enquiry is for; none = the whole wedding (23 Nov 2026)

  @@unique([weddingId, vendorId])
  @@index([status])
  @@map("vendor_quote_requests")
}

// One function a vendor enquiry is for (23 Nov 2026): one vendor can be asked about Haldi and Reception together.
model VendorQuoteFunction {
  id             String             @id @default(uuid())
  requestId      String
  request        VendorQuoteRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  weddingEventId String
  weddingEvent   WeddingEvent       @relation(fields: [weddingEventId], references: [id], onDelete: Cascade)

  @@unique([requestId, weddingEventId])
  @@index([weddingEventId])
  @@map("vendor_quote_functions")
}

// Family access (23 Nov 2026, Client OS): what a family member may do on a couple's wedding. The couple (Wedding.customerId) is the
// owner and the only one who adds or removes family. lib/customer/familyAccess.ts holds the rules.
enum FamilyRole {
  FULL // everything the couple sees and does, payments included (a partner, a parent who pays) — but not managing family
  PLANNING // functions, guests and vendors; no money (payments, receipts, invoices, prices)
  VIEW // sees the plan (functions, guests, vendors); changes nothing; no money
}

// A family member of a couple's wedding, signed in with their own mobile + code. A child record of the wedding (ownership).
model WeddingMember {
  id        String     @id @default(uuid())
  weddingId String
  wedding   Wedding    @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  relation  String? // "Bride's father", "Sister" …
  role      FamilyRole
  addedById String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([weddingId, userId])
  @@index([userId])
  @@map("wedding_members")
}

// A review of Shaadi Shopping itself (24 Nov 2026), from the public /review page (link or QR). Anyone may send one; it is PENDING
// and shown nowhere until staff publish it. The mobile and wedding ID are for staff to check it is genuine — never shown publicly.
model PlatformReview {
  id            String       @id @default(uuid())
  authorName    String
  rating        Int // 1-5
  comment       String?
  phone         String? // 10-digit mobile, optional, staff only
  weddingNumber String? // e.g. WED-2026-0002, optional, staff only
  status        ReviewStatus @default(PENDING)
  moderatedAt   DateTime?
  moderatedById String?
  moderatedBy   User?        @relation("PlatformReviewModeratedBy", fields: [moderatedById], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status, createdAt])
  @@map("platform_reviews")
}

// The couple's checklist in My Wedding (25 Nov 2026). Starts from a ready-made list dated back from the wedding (templateKey keeps it
// from being added twice); the couple ticks, edits, removes and adds their own. Separate from Task (the team's own work). Read-only
// to staff. Rules: lib/wedding/checklist.ts.
model CoupleChecklistItem {
  id             String        @id @default(uuid())
  weddingId      String
  wedding        Wedding       @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  title          String
  notes          String?
  dueDate        DateTime? // a date (UTC midnight); null = no date
  customDate     Boolean       @default(false) // the couple chose this date; a ready-made item's date no longer follows the wedding day
  weddingEventId String? // the function it is for (optional)
  weddingEvent   WeddingEvent? @relation(fields: [weddingEventId], references: [id], onDelete: SetNull)
  templateKey    String? // the ready-made item it came from; null = written by the couple
  hidden         Boolean       @default(false) // a ready-made item the couple removed (kept so it is not added again)
  done           Boolean       @default(false)
  doneAt         DateTime?
  doneById       String?
  sortOrder      Int           @default(0)
  createdById    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([weddingId, templateKey])
  @@index([weddingId, done])
  @@map("couple_checklist_items")
}

// The couple's planned amount for one budget category (25 Nov 2026). Rules: lib/wedding/coupleBudget.ts.
model CoupleBudgetCategory {
  id        String   @id @default(uuid())
  weddingId String
  wedding   Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  category  String // one of COUPLE_BUDGET_CATEGORIES
  planned   Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([weddingId, category])
  @@map("couple_budget_categories")
}

// Something the couple spends on themselves (outfits, jewellery, gifts …) — their own record, never an invoice or a payment of ours.
model CoupleExpense {
  id          String    @id @default(uuid())
  weddingId   String
  wedding     Wedding   @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  category    String // one of COUPLE_BUDGET_CATEGORIES
  title       String
  amount      Int // the whole cost
  paid        Int       @default(0) // how much of it they have paid
  spentOn     DateTime? // optional date
  notes       String?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([weddingId])
  @@map("couple_expenses")
}

// One payment Shaadi Shopping made to a vendor for one assigned work (25 Nov 2026) — an advance, a part or the final amount.
// Append-only: an entry is never edited or deleted; a mistake is voided (kept, with who and why) and the right one recorded.
// Rules and the totals both dashboards show: lib/vendor/vendorMoney.ts. (Payout stays as history: an older payout marked PAID still
// counts as paid.)
model VendorPayment {
  id              String        @id @default(uuid())
  vendorBookingId String
  vendorBooking   VendorBooking @relation(fields: [vendorBookingId], references: [id])
  vendorId        String
  vendor          Vendor        @relation(fields: [vendorId], references: [id])
  amount          Int // rupees, > 0
  paidOn          DateTime // the day the money went (UTC midnight of the India date)
  method          String // UPI / BANK_TRANSFER / CASH / CHEQUE / OTHER
  reference       String? // UTR, cheque number …
  note            String?
  recordedById    String?
  createdAt       DateTime      @default(now())
  voidedAt        DateTime?
  voidedById      String?
  voidReason      String?
  // The final payment before the work was verified (money design v1, PR 6): allowed only with a reason, recorded here.
  finalOverrideReason String?
  finalOverrideById   String?

  @@index([vendorBookingId])
  @@index([vendorId])
  @@map("vendor_payments")
}

// Finance audit log (money design v1, PR 2, 25 Nov 2026) — written ONLY by database triggers on the money tables (migration
// 20261125180000_finance_events): every insert, change or delete, with the row before and after. Append-only: the database refuses
// an update, delete or truncate. Who did it: `app.actor_id` set inside the transaction (lib/finance/audit.ts); NULL = unattributed.
// Read by the founder's reconciliation page only. Never written by the app.
model FinanceEvent {
  id         BigInt   @id @default(autoincrement())
  at         DateTime @default(now())
  tableName  String
  rowId      String
  action     String // INSERT / UPDATE / DELETE
  actorId    String?
  reason     String?
  businessId String?
  changed    String[] @default([])
  before     Json?
  after      Json?

  @@index([at])
  @@index([tableName, rowId])
  @@map("finance_events")
}

enum VendorPricingModel {
  COMMISSION
  FIXED
}

enum WorkOrderStatus {
  ISSUED
  CANCELLED
}

// A vendor work order (money design v1, PR 4, 25 Nov 2026): issued when the vendor confirms an assignment, numbered WO-YYYYMM-NNNN,
// and FROZEN — the database refuses any change to its number, amounts, model or scope (trigger work_order_frozen); it can only be
// cancelled, with who and why. The scope field is what the vendor sees (function, date, venue, service, deliverables, terms) together with
// vendorPayable. clientPrice, commission and margin are INTERNAL: never sent to a vendor (lib/vendor/workOrder.ts).
model VendorWorkOrder {
  id               String             @id @default(uuid())
  number           String             @unique
  vendorBookingId  String             @unique
  vendorBooking    VendorBooking      @relation(fields: [vendorBookingId], references: [id], onDelete: Cascade)
  vendorId         String
  vendor           Vendor             @relation(fields: [vendorId], references: [id])
  pricingModel     VendorPricingModel
  vendorPayable    Int // what the vendor is paid for this work
  clientPrice      Int // internal: the couple's price share for this service
  commissionRate   Float? // internal: COMMISSION only, frozen at issue
  commissionAmount Int? // internal: COMMISSION only
  margin           Int // internal: clientPrice − vendorPayable
  scope            Json // vendor-visible snapshot
  status           WorkOrderStatus    @default(ISSUED)
  historical       Boolean            @default(false) // issued later for an assignment confirmed before work orders existed
  issuedAt         DateTime           @default(now())
  issuedById       String?
  cancelledAt      DateTime?
  cancelledById    String?
  cancelReason     String?
  adjustments      WorkOrderAdjustment[] // changes after issue — never edits (PR 6)

  @@index([vendorId])
  @@map("vendor_work_orders")
}

enum AdjustmentKind {
  INCREASE
  DECREASE
  EXTRA_WORK
  CANCELLATION
}

// A change to an issued work order (money design v1, PR 6, 25 Nov 2026): the work order is never edited; the vendor's amount is its
// vendorPayable plus every adjustment. Append-only (the database refuses an update) and never below what was already paid (trigger).
// payableDelta is what the vendor sees; clientPriceDelta is internal (the couple's side of the same change, if any).
model WorkOrderAdjustment {
  id               String          @id @default(uuid())
  workOrderId      String
  workOrder        VendorWorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  kind             AdjustmentKind
  payableDelta     Int
  clientPriceDelta Int             @default(0)
  reason           String
  createdById      String?
  createdAt        DateTime        @default(now())

  @@index([workOrderId])
  @@map("work_order_adjustments")
}

// A credit note against a couple's invoice (money design v1, PR 7, 25 Nov 2026): the invoice is never edited — what the couple owes
// goes down by the credit. Numbered CN-YYYYMM-NNNN. Never changed (database rule); all credits on an invoice never above its total.
// gstAmount is the GST share of the credit (in proportion to the invoice's own GST); amount includes it.
model CreditNote {
  id          String   @id @default(uuid())
  number      String   @unique
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount      Int
  gstAmount   Int      @default(0)
  reason      String
  issuedAt    DateTime @default(now())
  issuedById  String?

  @@index([invoiceId])
  @@map("credit_notes")
}

enum ConfirmationStatus {
  CONFIRMED
  CANCELLED
}

// Services of a quotation confirmed together (money design v1, PR 8, 25 Nov 2026): the unit of money. Numbered CNF-YYYYMM-NNNN.
// Its figures and lines are frozen (database rule); it has its own agreement and its own advance and balance invoices. The rest of
// the quotation stays open for later. lib/commercial/confirmation.ts works the figures out.
model Confirmation {
  id                  String             @id @default(uuid())
  number              String             @unique
  quotationId         String
  quotation           Quotation          @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  quotationRevision   Int
  status              ConfirmationStatus @default(CONFIRMED)
  channel             String // IN_PERSON / CALL / WHATSAPP / COUPLE_LINK
  confirmedAt         DateTime           @default(now())
  confirmedById       String?
  subtotal            Int
  discount            Int
  taxable             Int
  gst                 Int
  total               Int
  confirmationPercent Int
  advance             Int
  weddingId           String? // set when it joins a wedding (PR 8b)
  lines               ConfirmationLine[]
  agreement           CommercialAgreement?
  invoices            Invoice[]
  createdAt           DateTime           @default(now())

  businessId String   @default("shaadi-shopping")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@index([quotationId])
  @@index([businessId])
  @@map("confirmations")
}

// One confirmed service, frozen. A quotation line is in at most one live confirmation (partial unique index in SQL).
model ConfirmationLine {
  id              String       @id @default(uuid())
  confirmationId  String
  confirmation    Confirmation @relation(fields: [confirmationId], references: [id], onDelete: Cascade)
  quotationItemId String // the quotation line it came from (kept as text: quotation lines are copied, never edited, on revision)
  sortOrder       Int
  description     String
  category        String?
  functionLabel   String?
  vendorId        String?
  quantity        Int
  unitPrice       Int
  amount          Int
  discountShare   Int
  taxable         Int
  gstRateBp       Int?
  gst             Int
  total           Int
  live            Boolean      @default(true) // false once its confirmation is cancelled

  @@index([confirmationId])
  @@map("confirmation_lines")
}
