  PUBLISHED
  CLOSED
  CANCELLED
}

enum EventPassTypeStatus {
  ACTIVE
  HIDDEN
}

enum EventOrderStatus {
  PENDING
  PAID
  PAYMENT_SUCCESS
  CONFIRMED
  CANCELLED
  REFUNDED
}

enum EventTicketStatus {
  ACTIVE
  CHECKED_IN
  CANCELLED
}

model Event {
